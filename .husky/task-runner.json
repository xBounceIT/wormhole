{
  "tasks": [
    {
      "name": "format-staged",
      "command": "dotnet",
      "args": [ "format", "Wormhole.sln", "--include", "${staged}", "--verify-no-changes", "--severity", "warn" ],
      "include": [ "**/*.cs" ],
      "exclude": [ "**/obj/**", "**/bin/**", "**/*.g.cs", "**/*.g.i.cs" ]
    },
    {
      "name": "build",
      "command": "dotnet",
      "args": [ "build", "Wormhole.csproj", "-c", "Debug", "-p:Platform=x64", "--no-restore", "--nologo", "-v", "q" ]
    },
    {
      "name": "format-all",
      "command": "dotnet",
      "args": [ "format", "Wormhole.sln", "--severity", "warn" ]
    }
  ]
}
