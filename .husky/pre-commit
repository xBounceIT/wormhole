#!/usr/bin/env sh
# Husky.NET pre-commit hook. On a fresh clone the runtime shim
# (.husky/_/husky.sh) is gitignored and does not exist yet, which would make
# the source below fail. Restore the hooks first so the hook always works even
# before the first build has run `dotnet husky install`.
if [ ! -f "$(dirname -- "$0")/_/husky.sh" ]; then
  dotnet tool restore
  dotnet husky install
fi
. "$(dirname -- "$0")/_/husky.sh"
set -e

dotnet husky run --name format-staged
dotnet husky run --name build
