<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Wormhole</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Wormhole.ico</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget Condition="('$(PlatformTarget)' == '' Or '$(PlatformTarget)' == 'AnyCPU' Or '$(PlatformTarget)' == 'Any CPU') And '$(RuntimeIdentifier)' == 'win-x64'">x64</PlatformTarget>
    <PlatformTarget Condition="('$(PlatformTarget)' == '' Or '$(PlatformTarget)' == 'AnyCPU' Or '$(PlatformTarget)' == 'Any CPU') And '$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="('$(PlatformTarget)' == '' Or '$(PlatformTarget)' == 'AnyCPU' Or '$(PlatformTarget)' == 'Any CPU') And '$(RuntimeIdentifier)' == '' And ('$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU')">x64</PlatformTarget>
    <PlatformTarget Condition="('$(PlatformTarget)' == '' Or '$(PlatformTarget)' == 'AnyCPU' Or '$(PlatformTarget)' == 'Any CPU') And '$(RuntimeIdentifier)' == '' And '$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="('$(PlatformTarget)' == '' Or '$(PlatformTarget)' == 'AnyCPU' Or '$(PlatformTarget)' == 'Any CPU') And '$(RuntimeIdentifier)' == '' And ('$(Platform)' == 'arm64' Or '$(Platform)' == 'ARM64')">ARM64</PlatformTarget>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;Wormhole.Tests\**;Wormhole.Tests.Integration\**;Assets\web\node_modules\**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <DefaultLanguage>en-US</DefaultLanguage>
    <WormholeUsePinnedSqliteNative>true</WormholeUsePinnedSqliteNative>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryUrl>https://github.com/xBounceIT/wormhole</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Daniel D'Angeli</Authors>
    <Copyright>Copyright (c) 2026 Daniel D'Angeli</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/xBounceIT/wormhole</PackageProjectUrl>
    <Description>Tabbed multi-protocol connection manager for Windows (SSH, RDP, VNC, SFTP, HTTP/HTTPS) with per-connection userspace VPN tunnels.</Description>
    <_WebView2LoaderRid Condition="'$(RuntimeIdentifier)' == 'win-x64'">win-x64</_WebView2LoaderRid>
    <_WebView2LoaderRid Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win-arm64</_WebView2LoaderRid>
    <_WebView2LoaderRid Condition="'$(_WebView2LoaderRid)' == '' And '$(PlatformTarget)' == 'x64'">win-x64</_WebView2LoaderRid>
    <_WebView2LoaderRid Condition="'$(_WebView2LoaderRid)' == '' And ('$(PlatformTarget)' == 'arm64' Or '$(PlatformTarget)' == 'ARM64')">win-arm64</_WebView2LoaderRid>
    <_WebView2LoaderRid Condition="'$(_WebView2LoaderRid)' == '' And ('$(PlatformTarget)' == 'AnyCPU' Or '$(PlatformTarget)' == 'Any CPU')">win-x64</_WebView2LoaderRid>
  </PropertyGroup>

  <!-- Release-only perf flags. R2R does ahead-of-time JIT at publish time so cold start
       on an installed app skips most first-time JIT work for the app's own assemblies.
       Composite R2R (PublishReadyToRunComposite) is intentionally left OFF: although
       scripts/Build-Installer.ps1 now publishes self-contained (so composite would be
       possible), per-assembly R2R already captures most of the cold-start win for an
       app this size, and keeping composite off avoids a larger, slower publish. PGO is on by default in .NET 10
       but pinned here for clarity. Debug builds keep JIT-only behavior so iteration
       time isn't paying the R2R cost on every F5. Workstation GC stays the default —
       WinUI desktop apps benefit more from its lower pause times than ServerGC's
       higher allocation throughput. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <!-- Required to host the in-app MCP server over Kestrel (loopback Streamable HTTP).
         Adds a runtime dependency on the ASP.NET Core shared framework — the installer
         must provide it (see scripts/Build-Installer.ps1). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" GeneratePathProperty="true" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Microsoft.Extensions.{DependencyInjection,Http,Logging,Logging.Abstractions} are provided
         by the Microsoft.AspNetCore.App framework reference (see above), so explicit PackageReferences
         to them are redundant (NuGet NU1510). -->
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="Community.MarcusW.VncClient" Version="2.0.4" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <!-- Official C# MCP SDK: hosts the in-app MCP server (AddMcpServer/WithHttpTransport/MapMcp). -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" Version="2.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.8" />
    <PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Markdig" Version="1.3.0" />
    <!-- BouncyCastle is required for the mRemoteNG XML importer: mRemoteNG uses a 16-byte
         GCM nonce, while System.Security.Cryptography.AesGcm only accepts 12-byte nonces. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_Web_WebView2)\runtimes\$(_WebView2LoaderRid)\native\WebView2Loader.dll"
          Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(PkgMicrosoft_Web_WebView2)' != '' And '$(_WebView2LoaderRid)' != '' And Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\$(_WebView2LoaderRid)\native\WebView2Loader.dll')" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Wormhole.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

  <!-- Intentionally non-incremental: the script's job includes SHA256 verification of
       pinned vendor files. If we let MSBuild skip the target once the outputs exist,
       a tampered vendor file would never be re-verified on incremental builds.
       The script is idempotent and fast (sub-second when hashes match). -->
  <Target Name="FetchWebAssets" BeforeTargets="BeforeBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\Fetch-WebAssets.ps1&quot; -Quiet" />
    <ItemGroup>
      <None Include="Assets\web\vendor\**\*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
  </Target>

  <!-- WireGuard userspace sidecar. The script either downloads a pinned release or, failing
       that, builds from tools\wormhole-wgproxy\ with the system Go toolchain. If neither is
       available it emits a warning but does not break the build (WireGuard tunnels will
       surface a clear runtime error instead). Non-incremental for the same reason as
       FetchWebAssets above. -->
  <Target Name="FetchWgProxy" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_WgProxyArch Condition="'$(PlatformTarget)' == 'ARM64' Or '$(PlatformTarget)' == 'arm64'">arm64</_WgProxyArch>
      <_WgProxyArch Condition="'$(_WgProxyArch)' == ''">x64</_WgProxyArch>
    </PropertyGroup>
    <!-- SkipSidecarFetch=true bypasses the (slow, toolchain-heavy) sidecar rebuild and reuses the
         binary already staged in obj/ — for iterating on managed code when the Go/C++/vcpkg
         toolchain is unavailable or flaking. Default-off: normal builds rebuild as before. -->
    <Exec Condition="'$(SkipSidecarFetch)' != 'true'" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\Fetch-WgProxy.ps1&quot; -Arch $(_WgProxyArch) -Quiet" />
    <ItemGroup>
      <None Include="$(MSBuildProjectDirectory)\obj\wgproxy\$(_WgProxyArch)\wormhole-wgproxy.exe"
            Condition="Exists('$(MSBuildProjectDirectory)\obj\wgproxy\$(_WgProxyArch)\wormhole-wgproxy.exe')">
        <Link>wormhole-wgproxy.exe</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

  <!-- Fortinet SSL VPN userspace sidecar. Same resolution policy as FetchWgProxy: pinned
       release -> source build -> non-fatal warning. Both Fetch* targets attach to
       BeforeBuild and run serially in declaration order (MSBuild BeforeTargets are not
       parallelized within a project); a slow `go mod download` in one will block the next. -->
  <Target Name="FetchFortiProxy" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_FortiProxyArch Condition="'$(PlatformTarget)' == 'ARM64' Or '$(PlatformTarget)' == 'arm64'">arm64</_FortiProxyArch>
      <_FortiProxyArch Condition="'$(_FortiProxyArch)' == ''">x64</_FortiProxyArch>
    </PropertyGroup>
    <Exec Condition="'$(SkipSidecarFetch)' != 'true'" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\Fetch-FortiProxy.ps1&quot; -Arch $(_FortiProxyArch) -Quiet" />
    <ItemGroup>
      <None Include="$(MSBuildProjectDirectory)\obj\fortiproxy\$(_FortiProxyArch)\wormhole-fortiproxy.exe"
            Condition="Exists('$(MSBuildProjectDirectory)\obj\fortiproxy\$(_FortiProxyArch)\wormhole-fortiproxy.exe')">
        <Link>wormhole-fortiproxy.exe</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

  <!-- Cisco Secure Client (AnyConnect) SSL VPN userspace sidecar. Same resolution policy as
       FetchFortiProxy: pinned release -> source build -> non-fatal warning. -->
  <Target Name="FetchCiscoProxy" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_CiscoProxyArch Condition="'$(PlatformTarget)' == 'ARM64' Or '$(PlatformTarget)' == 'arm64'">arm64</_CiscoProxyArch>
      <_CiscoProxyArch Condition="'$(_CiscoProxyArch)' == ''">x64</_CiscoProxyArch>
    </PropertyGroup>
    <Exec Condition="'$(SkipSidecarFetch)' != 'true'" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\Fetch-CiscoProxy.ps1&quot; -Arch $(_CiscoProxyArch) -Quiet" />
    <ItemGroup>
      <None Include="$(MSBuildProjectDirectory)\obj\ciscoproxy\$(_CiscoProxyArch)\wormhole-ciscoproxy.exe"
            Condition="Exists('$(MSBuildProjectDirectory)\obj\ciscoproxy\$(_CiscoProxyArch)\wormhole-ciscoproxy.exe')">
        <Link>wormhole-ciscoproxy.exe</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

  <!-- OpenVPN userspace sidecar. Mirrors FetchWgProxy above. The script either downloads a
       pinned release, builds from tools\wormhole-ovpnproxy\ with the full toolchain (Go +
       CMake + C++ + populated submodules) for a real OpenVPN3-linked binary, or falls back
       to a mock-only sidecar that still satisfies the wire protocol so the rest of the app
       keeps working. Missing toolchain warns but does not break the build. -->
  <Target Name="FetchOvpnProxy" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_OvpnProxyArch Condition="'$(PlatformTarget)' == 'ARM64' Or '$(PlatformTarget)' == 'arm64'">arm64</_OvpnProxyArch>
      <_OvpnProxyArch Condition="'$(_OvpnProxyArch)' == ''">x64</_OvpnProxyArch>
    </PropertyGroup>
    <Exec Condition="'$(SkipSidecarFetch)' != 'true'" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\Fetch-OvpnProxy.ps1&quot; -Arch $(_OvpnProxyArch) -Quiet" />
    <ItemGroup>
      <None Include="$(MSBuildProjectDirectory)\obj\ovpnproxy\$(_OvpnProxyArch)\wormhole-ovpnproxy.exe"
            Condition="Exists('$(MSBuildProjectDirectory)\obj\ovpnproxy\$(_OvpnProxyArch)\wormhole-ovpnproxy.exe')">
        <Link>wormhole-ovpnproxy.exe</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

  <Target Name="CopyWinUIAppResourcesToPublish"
          AfterTargets="Publish"
          Condition="'$(UseWinUI)' == 'true'">
    <ItemGroup>
      <_WinUIRootResource Include="$(TargetDir)$(AssemblyName).pri"
                          Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
      <_WinUIRootResource Include="$(TargetDir)App.xbf"
                          Condition="Exists('$(TargetDir)App.xbf')" />
      <_WinUIRootResource Include="$(TargetDir)MainWindow.xbf"
                          Condition="Exists('$(TargetDir)MainWindow.xbf')" />
      <_WinUIViewResource Include="$(TargetDir)Views\**\*.xbf"
                          Condition="Exists('$(TargetDir)Views')" />
    </ItemGroup>

    <Copy SourceFiles="@(_WinUIRootResource)"
          DestinationFiles="@(_WinUIRootResource->'$(PublishDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(_WinUIViewResource)"
          DestinationFiles="@(_WinUIViewResource->'$(PublishDir)Views\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
