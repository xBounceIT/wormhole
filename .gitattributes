# Normalize line endings: CRLF in the working tree on Windows, normalized in the repo.
* text=auto eol=crlf

# Hint git's diff machinery for C# files
*.cs text diff=csharp

# Shell scripts and Husky hooks: LF only. Git on Windows runs hooks via sh,
# which chokes on CRLF in the shebang line.
.husky/* text eol=lf
*.sh     text eol=lf

# Go sources and module files: LF only. `go mod tidy` / `gofmt` always write LF;
# without this override the * eol=crlf rule above would create perpetual diff
# churn every time someone bumps a dep in tools/wormhole-wgproxy/.
*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf

# OpenVPN3/mbedTLS submodule patches are applied by Fetch-OvpnProxy.ps1 via a strict
# `git apply` against the (LF) submodule sources. They MUST stay LF — under the default
# `* eol=crlf` rule above they'd check out as CRLF, the apply --check would fail on the
# EOL mismatch, and the build would silently drop the patch (broken sidecar).
tools/wormhole-ovpnproxy/patches/*.patch text eol=lf

# Binary file types this project may track
*.png binary
*.ico binary
*.dll binary
*.exe binary
*.pri binary
*.xbf binary

# Vendored web assets - skip GitHub language stats and collapse in diffs
Assets/web/vendor/**     linguist-vendored=true binary
Assets/web/bridge.js     linguist-vendored=true
Assets/web/terminal.html linguist-vendored=true

# Generated files
*.g.cs   linguist-generated=true
*.g.i.cs linguist-generated=true
