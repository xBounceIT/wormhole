<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wormhole.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wormhole.Models">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ComboBox Header="Theme"
                      SelectedIndex="{x:Bind ThemeIndex, Mode=TwoWay}"
                      Width="240">
                <ComboBoxItem Content="System default" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>

            <TextBlock Text="Tabs" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ToggleSwitch Header="Confirm before closing a connected tab"
                          IsOn="{x:Bind ViewModel.ConfirmOnTabClose, Mode=TwoWay}" />

            <TextBlock Text="Terminal" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ToggleSwitch Header="Auto-copy selection to clipboard"
                          IsOn="{x:Bind ViewModel.AutoCopyOnSelect, Mode=TwoWay}" />

            <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock Text="{x:Bind ViewModel.Update.CurrentVersionText, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Update.LastCheckText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.6" />
            <ToggleSwitch Header="Automatically check for updates on startup"
                          IsOn="{x:Bind ViewModel.AutoCheckForUpdates, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check now"
                        Command="{x:Bind ViewModel.Update.CheckNowCommand}"
                        IsEnabled="{x:Bind ViewModel.Update.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}" />
                <Button Content="Install update"
                        Command="{x:Bind ViewModel.Update.InstallCommand}"
                        Visibility="{x:Bind ViewModel.Update.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="View release notes"
                        Command="{x:Bind ViewModel.Update.OpenReleasePageCommand}"
                        Visibility="{x:Bind ViewModel.Update.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ProgressRing IsActive="{x:Bind ViewModel.Update.IsBusy, Mode=OneWay}"
                              Width="20" Height="20" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Update.Status, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.7" />
            <ProgressBar Minimum="0" Maximum="1"
                         Value="{x:Bind ViewModel.Update.DownloadProgress, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.Update.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <TextBlock Text="Backup &amp; Restore" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                Export your connections, credentials, SSH keys, and VPN tunnels to a JSON file,
                or restore a backup taken from another installation. Existing items with the
                same ID are kept; the import never overwrites.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Export backup..."
                        Command="{x:Bind ViewModel.ExportBackupCommand}" />
                <Button Content="Import backup..."
                        Command="{x:Bind ViewModel.ImportBackupCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
