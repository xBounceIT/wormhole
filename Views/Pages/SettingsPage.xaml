<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wormhole.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wormhole.Views.Controls">

    <Page.Resources>
        <!-- Shared layout for every settings tab's content so padding/width live in one place. -->
        <Style x:Key="TabContentScrollStyle" TargetType="ScrollViewer">
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="TabContentPanelStyle" TargetType="StackPanel">
            <Setter Property="Spacing" Value="16" />
            <Setter Property="MaxWidth" Value="720" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

        <TabView Grid.Row="1"
                 IsAddTabButtonVisible="False"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 TabWidthMode="SizeToContent">

            <!-- General: appearance, tabs, terminal -->
            <TabViewItem Header="General" IsClosable="False">
                <ScrollViewer Style="{StaticResource TabContentScrollStyle}">
                    <StackPanel Style="{StaticResource TabContentPanelStyle}">
                        <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ComboBox Header="Theme"
                                  SelectedIndex="{x:Bind ThemeIndex, Mode=TwoWay}"
                                  Width="240">
                            <ComboBoxItem Content="System default" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>

                        <TextBlock Text="Tabs" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <ToggleSwitch Header="Confirm before closing a connected tab"
                                      IsOn="{x:Bind ViewModel.ConfirmOnTabClose, Mode=TwoWay}" />

                        <TextBlock Text="Terminal" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <ToggleSwitch Header="Auto-copy selection to clipboard"
                                      IsOn="{x:Bind ViewModel.AutoCopyOnSelect, Mode=TwoWay}" />

                        <TextBlock Text="VPN" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <ToggleSwitch Header="Ask whether to use the tunnel when connecting"
                                      IsOn="{x:Bind ViewModel.PromptBeforeTunnelConnect, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                                   Text="When on, opening a connection that has a VPN tunnel configured asks whether to start the tunnel or connect directly. Useful for targets that are local on some networks and only reachable over the VPN on others — so you don't have to edit the connection each time you move networks." />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Security -->
            <TabViewItem Header="Security" IsClosable="False">
                <ScrollViewer Style="{StaticResource TabContentScrollStyle}">
                    <StackPanel Style="{StaticResource TabContentPanelStyle}">
                        <TextBlock Text="App authentication" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AppAuthenticationStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.75"
                                   TextWrapping="Wrap" />
                        <ComboBox Header="Unlock method"
                                  SelectedIndex="{x:Bind ViewModel.AppAuthenticationModeIndex, Mode=TwoWay}"
                                  Width="260"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="Disabled" />
                            <ComboBoxItem Content="PIN" />
                            <ComboBoxItem Content="Password" />
                            <ComboBoxItem Content="Windows Hello" />
                        </ComboBox>
                        <StackPanel Visibility="{x:Bind ViewModel.ShowWindowsHelloFallback, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.WindowsHelloStatus, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.75"
                                       TextWrapping="Wrap" />
                            <ComboBox Header="Windows Hello fallback"
                                      SelectedIndex="{x:Bind ViewModel.AppAuthenticationHelloFallbackIndex, Mode=TwoWay}"
                                      Width="260"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="PIN" />
                                <ComboBoxItem Content="Password" />
                            </ComboBox>
                            <Button Content="Refresh Windows Hello status"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RefreshWindowsHelloStatusCommand}" />
                        </StackPanel>
                        <ComboBox Header="Lock after inactivity"
                                  SelectedIndex="{x:Bind ViewModel.AppAuthenticationIdleTimeoutIndex, Mode=TwoWay}"
                                  Width="260"
                                  HorizontalAlignment="Left"
                                  IsEnabled="{x:Bind ViewModel.IsAppAuthenticationEnabled, Mode=OneWay}">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="1 minute" />
                            <ComboBoxItem Content="5 minutes" />
                            <ComboBoxItem Content="15 minutes" />
                            <ComboBoxItem Content="30 minutes" />
                            <ComboBoxItem Content="60 minutes" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.SetOrChangeAppAuthenticationSecretButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanSetOrChangeAppAuthenticationSecret, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.CanSetOrChangeAppAuthenticationSecret, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{x:Bind ViewModel.SetOrChangeAppAuthenticationSecretCommand}" />
                            <Button Content="Test unlock"
                                    IsEnabled="{x:Bind ViewModel.CanTestAppAuthentication, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.TestAppAuthenticationCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Updates -->
            <TabViewItem Header="Updates" IsClosable="False">
                <ScrollViewer Style="{StaticResource TabContentScrollStyle}">
                    <StackPanel Style="{StaticResource TabContentPanelStyle}">
                        <TextBlock Text="{x:Bind ViewModel.Update.CurrentVersionText, Mode=OneWay}"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Update.LastCheckText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.6" />
                        <ToggleSwitch Header="Automatically check for updates on startup"
                                      IsOn="{x:Bind ViewModel.AutoCheckForUpdates, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Check now"
                                    Command="{x:Bind ViewModel.Update.CheckNowCommand}"
                                    IsEnabled="{x:Bind ViewModel.Update.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}" />
                            <Button Content="Install update"
                                    Command="{x:Bind ViewModel.Update.InstallCommand}"
                                    Visibility="{x:Bind ViewModel.Update.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button Content="View release notes"
                                    Command="{x:Bind ViewModel.Update.OpenReleasePageCommand}"
                                    Visibility="{x:Bind ViewModel.Update.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.Update.IsBusy, Mode=OneWay}"
                                          Width="20" Height="20" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Update.Status, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{x:Bind ViewModel.Update.DownloadProgress, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.Update.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Spacing="8"
                                    Margin="0,8,0,0"
                                    Visibility="{x:Bind ViewModel.Update.ShowChangelog, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.Update.ChangelogTitle, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Border MinHeight="300"
                                    BorderBrush="#40606A78"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <controls:UpdateChangelogView
                                    MinHeight="300"
                                    HtmlDocument="{x:Bind ViewModel.Update.ChangelogHtml, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Backup & Restore -->
            <TabViewItem Header="Backup &amp; Restore" IsClosable="False">
                <ScrollViewer Style="{StaticResource TabContentScrollStyle}">
                    <StackPanel Style="{StaticResource TabContentPanelStyle}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                            Export your connections, credentials, SSH keys, and VPN tunnels to a JSON file,
                            or restore a backup taken from another installation. Existing items with the
                            same ID are kept; the import never overwrites.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Export backup..."
                                    Command="{x:Bind ViewModel.ExportBackupCommand}" />
                            <Button Content="Import backup..."
                                    Command="{x:Bind ViewModel.ImportBackupCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- AI agent control (MCP server) -->
            <TabViewItem Header="AI Agent (MCP)" IsClosable="False">
                <ScrollViewer Style="{StaticResource TabContentScrollStyle}">
                    <StackPanel Style="{StaticResource TabContentPanelStyle}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                            Run a local MCP server so an AI agent (e.g. Claude) can control your already-open
                            SSH sessions — list them, run commands, type input, and read the terminal. The
                            server listens on localhost only and requires the bearer token below. The first
                            time an agent touches a session, Wormhole asks you to approve it.
                        </TextBlock>
                        <ToggleSwitch Header="Enable MCP server"
                                      IsOn="{x:Bind ViewModel.EnableMcpServer, Mode=TwoWay}" />
                        <ToggleSwitch Header="Stream command typing in terminal"
                                      IsOn="{x:Bind ViewModel.StreamMcpCommandTyping, Mode=TwoWay}" />
                        <NumberBox Header="Port"
                                   Value="{x:Bind ViewModel.McpServerPort, Mode=TwoWay}"
                                   SpinButtonPlacementMode="Inline"
                                   Minimum="1" Maximum="65535"
                                   Width="200"
                                   HorizontalAlignment="Left"
                                   IsEnabled="{x:Bind ViewModel.EnableMcpServer, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.McpStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Header="Endpoint"
                                     Text="{x:Bind ViewModel.McpEndpoint, Mode=OneWay}"
                                     IsReadOnly="True" IsSpellCheckEnabled="False"
                                     Width="300" />
                            <Button Content="Copy" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.CopyMcpEndpointCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Header="Bearer token"
                                     Text="{x:Bind ViewModel.McpToken, Mode=OneWay}"
                                     IsReadOnly="True" IsSpellCheckEnabled="False"
                                     PlaceholderText="•••••••• (hidden — click Reveal)"
                                     Width="380" />
                            <Button Content="Reveal / hide" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.RevealMcpTokenCommand}" />
                            <Button Content="Copy" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.CopyMcpTokenCommand}" />
                            <Button Content="Regenerate" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.RegenerateMcpTokenCommand}" />
                        </StackPanel>

                        <ComboBox Header="Client"
                                  SelectedIndex="{x:Bind ViewModel.McpClientIndex, Mode=TwoWay}"
                                  Width="240" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <ComboBoxItem Content="Claude Code CLI" />
                            <ComboBoxItem Content="Claude Desktop" />
                            <ComboBoxItem Content="Codex" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap"
                                   Text="{x:Bind ViewModel.McpConfigCaption, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="Reveal the token first to include it in the box below, or just use Copy config which always copies the real token." />
                        <TextBox Header="{x:Bind ViewModel.McpConfigLabel, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.McpConfigJson, Mode=OneWay}"
                                 IsReadOnly="True" IsSpellCheckEnabled="False"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12"
                                 Height="240" Width="520"
                                 HorizontalAlignment="Left"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Button Content="Copy config"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.CopyMcpConfigCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
