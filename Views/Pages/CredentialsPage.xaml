<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wormhole.Views.Pages.CredentialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wormhole.Models">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Credentials"
                   Style="{StaticResource TitleTextBlockStyle}" />

        <!-- Search row + contextual action strip share Row=1 inside a StackPanel so the strip
             takes zero space (and adds no RowSpacing) when nothing is selected. Putting the
             strip in its own Auto Grid row would leave a phantom 12px gap when collapsed
             (microsoft-ui-xaml#916). -->
        <StackPanel Grid.Row="1" Spacing="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="SearchBox"
                         PlaceholderText="Search credentials"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxWidth="480"
                         HorizontalAlignment="Stretch" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Command="{x:Bind ViewModel.SelectAllCommand}"
                            ToolTipService.ToolTip="Select all visible credentials">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8B3;" />
                            <TextBlock Text="Select all" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.AddCredentialCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Add credential" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border CornerRadius="6"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="12,8,12,8"
                    Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon FontSize="14" Glyph="&#xE73A;" Opacity="0.8" />
                        <TextBlock Text="{x:Bind ViewModel.SelectionStatus, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Click="OnClearSelectionClick"
                                ToolTipService.ToolTip="Clear selection">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE894;" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Delete selected credentials">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock Text="Delete selected" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    MaxWidth="420"
                    Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <FontIcon Glyph="&#xE192;" FontSize="48" Opacity="0.5" />
            <TextBlock Text="No credentials yet"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Add a credential to reuse a username and password (and optional domain) across SSH and RDP connections."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    MaxWidth="420"
                    Visibility="{x:Bind ViewModel.HasNoMatches, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <FontIcon Glyph="&#xE721;" FontSize="36" Opacity="0.5" />
            <TextBlock Text="No credentials match your search"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Opacity="0.7"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- SelectionMode=None: WinUI 3 GridView's built-in multi-select chrome puts a
             checkmark overlay top-right and tints the card on selection. We want neither.
             Instead we render our own CheckBox at the bottom-left of each card and route
             selection through code-behind to ViewModel.SelectedCredentials.

             No outer ScrollViewer — it would disable UI virtualization and realize every
             card at load (see CLAUDE.md conventions). -->
        <GridView x:Name="CredentialsGrid"
                  Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.FilteredCredentials, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  ContainerContentChanging="OnContainerContentChanging"
                  Visibility="{x:Bind ViewModel.HasMatches, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:CredentialProfile">
                    <Border CornerRadius="8"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="14"
                            Width="260"
                            Height="140"
                            Margin="0,0,12,12"
                            DoubleTapped="OnCardDoubleTapped">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Edit"
                                                Click="OnEditMenuItemClick"
                                                IsEnabled="{x:Bind IsReadOnly, Converter={StaticResource InverseBoolConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Delete"
                                                Click="OnDeleteMenuItemClick"
                                                IsEnabled="{x:Bind IsReadOnly, Converter={StaticResource InverseBoolConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Border.ContextFlyout>

                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1"
                                        CornerRadius="4"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        Padding="6,2,6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ProtocolLabel}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE77B;" Opacity="0.7" />
                                <TextBlock Text="{x:Bind Username}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="0.85"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            Visibility="{x:Bind Domain, Converter={StaticResource StringPresentVisibilityConverter}}">
                                    <FontIcon FontSize="12" Glyph="&#xE968;" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind Domain}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Opacity="0.85"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border CornerRadius="4"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Padding="6,2,6,2"
                                        HorizontalAlignment="Left"
                                        Visibility="{x:Bind IsBitwarden, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Bitwarden"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               FontSize="11" />
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- IsChecked / Tag are wired up by the page code-behind in
                                     OnContainerContentChanging (initial state) and
                                     OnSelectionCheckBoxClick (toggle → VM). MinWidth=0 strips
                                     the CheckBox's default ~120px width since we have no Content. -->
                                <CheckBox x:Name="SelectCheckBox"
                                          Grid.Column="0"
                                          MinWidth="0"
                                          Padding="0"
                                          Margin="0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          ToolTipService.ToolTip="Select"
                                          AutomationProperties.Name="Select credential"
                                          Tag="{x:Bind}"
                                          Click="OnSelectionCheckBoxClick" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Click="OnEditMenuItemClick"
                                            IsEnabled="{x:Bind IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                                            ToolTipService.ToolTip="Edit"
                                            AutomationProperties.Name="Edit">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Click="OnDeleteMenuItemClick"
                                            IsEnabled="{x:Bind IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                                            ToolTipService.ToolTip="Delete"
                                            AutomationProperties.Name="Delete">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
