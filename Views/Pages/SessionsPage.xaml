<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wormhole.Views.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sessions="using:Wormhole.ViewModels.Sessions"
    xmlns:sessionViews="using:Wormhole.Views.Sessions">

    <Page.Resources>
        <DataTemplate x:Key="SshSessionTemplate" x:DataType="sessions:SshSessionViewModel">
            <sessionViews:SshTerminalView HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          MinHeight="240" />
        </DataTemplate>

        <DataTemplate x:Key="RdpSessionTemplate" x:DataType="sessions:RdpSessionViewModel">
            <sessionViews:RdpSurfaceHost HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         MinHeight="240" />
        </DataTemplate>

        <DataTemplate x:Key="ProtocolPlaceholderTemplate" x:DataType="sessions:SessionTabViewModel">
            <Grid Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           Text="This protocol surface is not implemented yet." />
            </Grid>
        </DataTemplate>

        <sessionViews:SessionContentSelector x:Key="SessionContentSelector"
                                             SshTemplate="{StaticResource SshSessionTemplate}"
                                             RdpTemplate="{StaticResource RdpSessionTemplate}"
                                             SftpTemplate="{StaticResource ProtocolPlaceholderTemplate}"
                                             PlaceholderTemplate="{StaticResource ProtocolPlaceholderTemplate}" />
    </Page.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    MaxWidth="420"
                    Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <FontIcon Glyph="&#xE968;" FontSize="48" Opacity="0.5" />
            <TextBlock Text="No active sessions"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Pick a connection from the tree or use Quick Connect to start a session."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TabView x:Name="SessionTabs"
                 TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                 SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                 TabWidthMode="SizeToContent"
                 IsAddTabButtonVisible="False"
                 CanReorderTabs="True"
                 CanDragTabs="True"
                 TabCloseRequested="SessionTabs_TabCloseRequested"
                 Background="Transparent"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Visibility="{x:Bind ViewModel.HasTabs, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="sessions:SessionTabViewModel">
                    <TabViewItem Header="{x:Bind Title, Mode=OneWay}"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
                        <TabViewItem.ContextFlyout>
                            <!-- Click handlers (not Command bindings) because ElementName binding
                                 can't escape the DataTemplate's namescope into the MenuFlyout popup. -->
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Duplicate" Click="OnTabDuplicateClick" />
                                <MenuFlyoutItem Text="Reconnect"
                                                Click="OnTabReconnectClick"
                                                Command="{x:Bind ReconnectCommand, Mode=OneTime}"
                                                Visibility="{x:Bind CanReconnect, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Close" Click="OnTabCloseClick" />
                            </MenuFlyout>
                        </TabViewItem.ContextFlyout>
                        <ContentControl Content="{x:Bind}"
                                        ContentTemplateSelector="{StaticResource SessionContentSelector}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        MinHeight="240"
                                        IsTabStop="False" />
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>
    </Grid>
</Page>
