<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wormhole.Views.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sessions="using:Wormhole.ViewModels.Sessions"
    xmlns:sessionViews="using:Wormhole.Views.Sessions"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="SshSessionTemplate" x:DataType="sessions:SshSessionViewModel">
            <sessionViews:SshTerminalView HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          MinHeight="240" />
        </DataTemplate>

        <DataTemplate x:Key="RdpSessionTemplate" x:DataType="sessions:RdpSessionViewModel">
            <sessionViews:RdpSurfaceHost HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         MinHeight="240" />
        </DataTemplate>

        <DataTemplate x:Key="HttpSessionTemplate" x:DataType="sessions:HttpSessionViewModel">
            <sessionViews:WebBrowserView HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         MinHeight="240" />
        </DataTemplate>

        <DataTemplate x:Key="ProtocolPlaceholderTemplate" x:DataType="sessions:SessionTabViewModel">
            <Grid Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           Text="This protocol surface is not implemented yet." />
            </Grid>
        </DataTemplate>

        <sessionViews:SessionContentSelector x:Key="SessionContentSelector"
                                             SshTemplate="{StaticResource SshSessionTemplate}"
                                             RdpTemplate="{StaticResource RdpSessionTemplate}"
                                             HttpTemplate="{StaticResource HttpSessionTemplate}"
                                             PlaceholderTemplate="{StaticResource ProtocolPlaceholderTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid Background="#0c0c0c"
              Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="420">
                <FontIcon Glyph="&#xE968;" FontSize="48" Opacity="0.5" />
                <TextBlock Text="No active sessions"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Pick a connection from the tree or use Quick Connect to start a session."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Opacity="0.7"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <TabView x:Name="SessionTabs"
                 TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                 SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                 TabWidthMode="SizeToContent"
                 IsAddTabButtonVisible="False"
                 CanReorderTabs="True"
                 CanDragTabs="True"
                 TabCloseRequested="SessionTabs_TabCloseRequested"
                 Background="Transparent"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Visibility="{x:Bind ViewModel.HasTabs, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="sessions:SessionTabViewModel">
                    <TabViewItem HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
                        <TabViewItem.Header>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Title, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1"
                                        Click="OnTabFileTransferClick"
                                        Visibility="{x:Bind CanOpenFileTransfer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Style="{StaticResource IconButtonStyle}"
                                        Padding="4"
                                        MinWidth="0"
                                        MinHeight="0"
                                        ToolTipService.ToolTip="File transfer">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                                </Button>
                            </Grid>
                        </TabViewItem.Header>
                        <TabViewItem.ContextFlyout>
                            <!-- Click handlers (not Command bindings) because ElementName binding
                                 can't escape the DataTemplate's namescope into the MenuFlyout popup.
                                 Opened/Closed suppress the connected RDP overlay (a top-level window
                                 above WinUI) for the menu's lifetime, otherwise the menu — which drops
                                 over the session content area — is occluded by the overlay. -->
                            <MenuFlyout Opened="OnTabContextFlyoutOpened"
                                        Closed="OnTabContextFlyoutClosed">
                                <MenuFlyoutItem Text="Duplicate" Click="OnTabDuplicateClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Reconnect"
                                                Click="OnTabReconnectClick"
                                                Command="{x:Bind ReconnectCommand, Mode=OneTime}"
                                                Visibility="{x:Bind CanReconnect, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="File transfer"
                                                Click="OnTabFileTransferClick"
                                                Visibility="{x:Bind CanOpenFileTransfer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <!-- Disconnect / Open-External for RDP: the connected RDP surface is a top-level
                                     overlay that intercepts right-clicks (they go to the remote desktop), so its
                                     own ContextFlyout can't open over a live session. Surface these here instead. -->
                                <MenuFlyoutItem Text="Disconnect"
                                                Command="{x:Bind TabDisconnectCommand, Mode=OneWay}"
                                                Visibility="{x:Bind CanTabDisconnect, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8BB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open in System Remote Desktop"
                                                Command="{x:Bind TabUseExternalClientCommand, Mode=OneWay}"
                                                Visibility="{x:Bind CanTabUseExternalClient, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Close" Click="OnTabCloseClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE894;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </TabViewItem.ContextFlyout>
                        <ContentControl Content="{x:Bind}"
                                        ContentTemplateSelector="{StaticResource SessionContentSelector}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        MinHeight="240"
                                        IsTabStop="False" />
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>
    </Grid>
</Page>
