<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Controls.TransferQueueStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:transfer="using:Wormhole.ViewModels.Sessions.Transfer">

    <Border Padding="8"
            BorderThickness="1,1,1,1"
            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
            CornerRadius="4">
        <Grid RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Transfers"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind Transfers, Mode=OneWay}"
                      SelectionMode="None"
                      MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="transfer:TransferItemViewModel">
                        <Grid ColumnSpacing="8" Padding="0,2"
                              ToolTipService.ToolTip="{x:Bind ErrorMessage, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind DisplayName, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Column="1"
                                         Value="{x:Bind ProgressFraction, Mode=OneWay, Converter={StaticResource ProgressFractionConverter}}"
                                         Maximum="100"
                                         VerticalAlignment="Center" />
                            <!-- Terminal-state status glyph: a fully-filled progress bar is
                                 visually indistinguishable from a 99%-filled one, so without
                                 this icon the user can't tell whether a transfer is in flight
                                 or just sitting at 100%. Visible only for terminal states; the
                                 glyph + Foreground brush together signal success/failure at a
                                 glance. -->
                            <FontIcon Grid.Column="2"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Glyph="{x:Bind State, Mode=OneWay, Converter={StaticResource TransferStateGlyphConverter}}"
                                      Visibility="{x:Bind State, Mode=OneWay, Converter={StaticResource TransferStateTerminalVisibilityConverter}}"
                                      Foreground="{x:Bind State, Mode=OneWay, Converter={StaticResource TransferStateBrushConverter}}" />
                            <Button Grid.Column="3"
                                    Command="{x:Bind CancelCommand}"
                                    ToolTipService.ToolTip="Cancel or remove"
                                    Style="{StaticResource IconButtonStyle}">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
