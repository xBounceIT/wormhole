<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Controls.ConnectionTreeView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Wormhole.ViewModels"
    xmlns:models="using:Wormhole.Models">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control,Shift" Key="N" Invoked="OnNewFolderAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnNewConnectionAccelerator" />
        <KeyboardAccelerator Key="F2" Invoked="OnRenameAccelerator" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
        <KeyboardAccelerator Key="Enter" Invoked="OnOpenAccelerator" />
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="HeaderRow" Margin="4,8,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Connections"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind ViewModel.ExpandAllCommand}"
                        ToolTipService.ToolTip="Expand all folders"
                        AutomationProperties.Name="Expand all folders">
                    <FontIcon FontSize="14" Glyph="&#xE70D;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind ViewModel.CollapseAllCommand}"
                        ToolTipService.ToolTip="Collapse all folders"
                        AutomationProperties.Name="Collapse all folders">
                    <FontIcon FontSize="14" Glyph="&#xE70E;" />
                </Button>
                <DropDownButton Style="{StaticResource IconDropDownButtonStyle}"
                                ToolTipService.ToolTip="Import connections from third parties"
                                AutomationProperties.Name="Import connections from third parties">
                    <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Import from mRemoteNG"
                                            Command="{x:Bind ViewModel.ImportFromMRemoteNgCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind ViewModel.AddFolderCommand}"
                        ToolTipService.ToolTip="New folder (Ctrl+Shift+N)"
                        AutomationProperties.Name="New folder">
                    <FontIcon FontSize="14" Glyph="&#xE8F4;" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind ViewModel.AddConnectionCommand}"
                        ToolTipService.ToolTip="New connection (Ctrl+N)"
                        AutomationProperties.Name="New connection">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="4,0,4,4" Spacing="2">
            <AutoSuggestBox PlaceholderText="Search"
                            QueryIcon="Find"
                            AutomationProperties.Name="Search connections"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.7"
                       Visibility="{x:Bind ViewModel.SearchStatusText, Mode=OneWay, Converter={StaticResource StringPresentVisibilityConverter}}" />
        </StackPanel>

        <TreeView Grid.Row="2"
                  x:Name="Tree"
                  ItemsSource="{x:Bind ViewModel.DisplayRoots, Mode=OneWay}"
                  SelectionMode="Multiple"
                  CanDragItems="{x:Bind ViewModel.IsSearchActive, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                  CanReorderItems="{x:Bind ViewModel.IsSearchActive, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                  AllowDrop="{x:Bind ViewModel.IsSearchActive, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                  SelectionChanged="OnTreeSelectionChanged"
                  DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted"
                  ItemInvoked="OnTreeItemInvoked">
            <!-- ItemInvoked fires on single-click: we toggle folder expansion (so the
                 whole row is a hit target, not just the chevron) but ignore connection
                 nodes — those still open via DoubleTapped on the item template, since
                 single-click would cause accidental session opens. -->

            <TreeView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="New folder"
                                    Command="{x:Bind ViewModel.AddFolderCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8F4;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="New connection"
                                    Command="{x:Bind ViewModel.AddConnectionCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </TreeView.ContextFlyout>

            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:TreeNodeViewModel">
                    <TreeViewItem ItemsSource="{x:Bind DisplayChildren, Mode=OneWay}"
                                  IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind Host, Mode=OneWay}"
                                  Loaded="OnTreeItemLoaded"
                                  Unloaded="OnTreeItemUnloaded"
                                  PointerEntered="OnTreeItemPointerEntered"
                                  PointerExited="OnTreeItemPointerExited"
                                  DoubleTapped="OnNodeDoubleTapped">
                        <TreeViewItem.ContextFlyout>
                            <!-- Click handlers (not Command bindings) because ElementName binding
                                 can't escape the DataTemplate's namescope into the MenuFlyout popup. -->
                            <MenuFlyout>
                                <MenuFlyoutItem Text="New folder"
                                                Click="OnAddFolderItemClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F4;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="New connection"
                                                Click="OnAddConnectionItemClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Show credentials"
                                                Click="OnShowCredentialsItemClick"
                                                Visibility="{x:Bind IsConnection, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7B3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Duplicate connection"
                                                Click="OnDuplicateItemClick"
                                                Visibility="{x:Bind IsConnection, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Edit"
                                                Click="OnEditItemClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Delete"
                                                Click="OnDeleteItemClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </TreeViewItem.ContextFlyout>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="{x:Bind Glyph, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
