<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Controls.ConnectionTreeView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Wormhole.ViewModels"
    xmlns:models="using:Wormhole.Models">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control,Shift" Key="N" Invoked="OnNewFolderAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnNewConnectionAccelerator" />
        <KeyboardAccelerator Key="F2" Invoked="OnRenameAccelerator" />
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,8,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Connections"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Command="{x:Bind ViewModel.AddFolderCommand}"
                        ToolTipService.ToolTip="New folder (Ctrl+Shift+N)"
                        AutomationProperties.Name="New folder"
                        Background="Transparent" BorderBrush="Transparent" Padding="6">
                    <FontIcon FontSize="14" Glyph="&#xE8F4;" />
                </Button>
                <Button Command="{x:Bind ViewModel.AddConnectionCommand}"
                        ToolTipService.ToolTip="New connection (Ctrl+N)"
                        AutomationProperties.Name="New connection"
                        Background="Transparent" BorderBrush="Transparent" Padding="6">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                </Button>
            </StackPanel>
        </Grid>

        <TreeView Grid.Row="1"
                  x:Name="Tree"
                  ItemsSource="{x:Bind ViewModel.Roots, Mode=OneWay}"
                  SelectionMode="Single"
                  CanDragItems="True"
                  CanReorderItems="True"
                  AllowDrop="True"
                  DragItemsCompleted="OnDragItemsCompleted">
            <TreeView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="New folder"
                                    Command="{x:Bind ViewModel.AddFolderCommand}" />
                    <MenuFlyoutItem Text="New connection"
                                    Command="{x:Bind ViewModel.AddConnectionCommand}" />
                </MenuFlyout>
            </TreeView.ContextFlyout>

            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:TreeNodeViewModel">
                    <TreeViewItem ItemsSource="{x:Bind Children}"
                                  IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                        <TreeViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="New folder"
                                                Command="{Binding ViewModel.AddFolderCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />
                                <MenuFlyoutItem Text="New connection"
                                                Command="{Binding ViewModel.AddConnectionCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Edit"
                                                Command="{Binding ViewModel.EditCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />
                                <MenuFlyoutItem Text="Delete"
                                                Command="{Binding ViewModel.DeleteCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />
                            </MenuFlyout>
                        </TreeViewItem.ContextFlyout>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
