<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Controls.QuickConnectBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Wormhole.ViewModels">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox Grid.Column="0"
                  x:Name="ProtocolPicker"
                  ItemsSource="{x:Bind ViewModel.ProtocolChoices}"
                  SelectedItem="{x:Bind ViewModel.SelectedProtocolChoice, Mode=TwoWay}"
                  DisplayMemberPath="Label"
                  MinWidth="80" />

        <TextBox Grid.Column="1"
                 PlaceholderText="{x:Bind ViewModel.HostPlaceholder, Mode=OneWay}"
                 Margin="6,0,6,0"
                 Text="{x:Bind ViewModel.Host, Mode=TwoWay}" />

        <Button Grid.Column="2"
                Content="Connect"
                Command="{x:Bind ViewModel.ConnectCommand}" />
    </Grid>
</UserControl>