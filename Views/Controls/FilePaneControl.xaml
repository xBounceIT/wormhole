<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Controls.FilePaneControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:transfer="using:Wormhole.ViewModels.Sessions.Transfer">

    <UserControl.Resources>
        <!-- Shared MenuFlyout instance: ContainerContentChanging assigns this same
             instance to every realized ListViewItem.ContextFlyout. This is the
             canonical Files-app pattern: putting ContextFlyout on ListView fires
             ContextRequested with OriginalSource = the ListView/ScrollViewer
             (an ancestor of ListViewItem), so walking up to find the right-clicked
             row is impossible. Per-container wiring solves that AND restricts the
             menu to rows (no menu on empty list background). -->
        <MenuFlyout x:Key="EntryContextFlyout">
            <MenuFlyoutItem Text="Open" Click="OnContextOpenClick">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Rename" Click="OnContextRenameClick">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Delete" Click="OnContextDeleteClick">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- VerticalAlignment="Stretch" so the button matches the TextBox row
                 height (~32px). Without this the button uses its content's natural
                 size (a 14pt FontIcon plus padding) and renders visibly shorter than
                 the adjacent path TextBox. Glyph E70E is the standard Segoe Fluent
                 "Up" arrow — same icon File Explorer uses for parent-directory nav. -->
            <Button Grid.Column="0"
                    ToolTipService.ToolTip="Up one level"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.GoUpCommand, Mode=OneWay}">
                <FontIcon Glyph="&#xE70E;" FontSize="14" />
            </Button>
            <TextBox Grid.Column="1"
                     x:Name="PathBox"
                     Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                     KeyDown="OnPathBoxKeyDown" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
            <Button ToolTipService.ToolTip="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button ToolTipService.ToolTip="New folder"
                    Click="OnNewFolderClick">
                <FontIcon Glyph="&#xE8F4;" FontSize="14" />
            </Button>
            <Button ToolTipService.ToolTip="New file"
                    Click="OnNewFileClick">
                <FontIcon Glyph="&#xE7C3;" FontSize="14" />
            </Button>
            <Button ToolTipService.ToolTip="Delete selected"
                    Click="OnDeleteClick">
                <FontIcon Glyph="&#xE74D;" FontSize="14" />
            </Button>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="20" Height="20"
                          VerticalAlignment="Center"
                          Margin="6,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="EntriesList"
                      Grid.Row="0"
                      ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                      SelectionMode="Extended"
                      CanDragItems="True"
                      AllowDrop="True"
                      DragItemsStarting="OnDragItemsStarting"
                      DragOver="OnDragOver"
                      Drop="OnDrop"
                      DoubleTapped="OnEntryDoubleTapped"
                      SelectionChanged="OnSelectionChanged"
                      ContainerContentChanging="OnEntriesContainerContentChanging"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource ControlElevationBorderBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="transfer:FileEntryViewModel">
                        <Grid ColumnSpacing="8" Padding="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="{x:Bind IsDirectory, Converter={StaticResource DirectoryGlyphConverter}, Mode=OneWay}"
                                      FontSize="14" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Name, Mode=OneWay}"
                                       Visibility="{x:Bind IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{x:Bind IsEditing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                     KeyDown="OnRenameKeyDown"
                                     LostFocus="OnRenameLostFocus"
                                     Loaded="OnRenameTextBoxLoaded"
                                     Tag="{x:Bind}" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind Size, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}"
                                       Opacity="0.7"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind LastModifiedUtc, Converter={StaticResource UtcDateConverter}, Mode=OneWay}"
                                       Opacity="0.7"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="1"
                       Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Visibility="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource StringPresentVisibilityConverter}, Mode=OneWay}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
