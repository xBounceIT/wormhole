<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Sessions.SshTerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="#0c0c0c"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          MinHeight="240">
        <controls:WebView2 x:Name="TerminalView"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           MinHeight="240" />

        <Border Background="#CC0c0c0c"
                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="32" Height="32" />
                <TextBlock Text="Connecting..."
                           HorizontalAlignment="Center"
                           Foreground="#e0e0e0" />
            </StackPanel>
        </Border>

        <Border Background="#CC20242f"
                BorderBrush="#4456677a"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,6"
                Margin="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                MaxWidth="360"
                IsHitTestVisible="False"
                Visibility="{Binding IsWaitingForRemoteOutput, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Connected. Waiting for remote shell output..."
                       TextWrapping="Wrap"
                       Foreground="#e0e0e0"
                       FontSize="12" />
        </Border>

        <Border Background="#E60c0c0c"
                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="480"
                        Padding="24">
                <FontIcon Glyph="&#xE783;" FontSize="32" Foreground="#FF6B6B"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Connection failed"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="#e0e0e0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="#e0e0e0"
                           Opacity="0.85" />
                <Button Content="Retry"
                        Command="{Binding RetryCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
