<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Sessions.SshTerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:Wormhole.Views.Sessions">

    <Grid Background="#0c0c0c"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          MinHeight="240">
        <!-- DefaultBackgroundColor matches the Grid + terminal.html (#0c0c0c) so the
             WebView2 doesn't flash its default white during the brief window between
             control creation and xterm.js painting. -->
        <controls:WebView2 x:Name="TerminalView"
                           DefaultBackgroundColor="#0c0c0c"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           MinHeight="240" />

        <!-- Base cover: opaque whenever NOT Connected. Closes the per-overlay
             binding-update window — the Connecting/Failed bindings can update
             as separate compositor frames, briefly exposing the WebView2 (and
             xterm.js's prior content) when transitioning Failed→Connecting or
             Connected→Failed. This Border is bound to IsConnected (inverted),
             which doesn't change during those transitions, so it stays Visible
             across them and never lets phantom text bleed through. -->
        <Border Background="#0c0c0c"
                IsHitTestVisible="False"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

        <Border Background="#0c0c0c"
                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <!-- Tunneled connections: numbered, phased stepper. Foreground is set explicitly
                     because this overlay is always dark (#0c0c0c) regardless of the app theme, so
                     the inherited default text color would be unreadable in light theme. -->
                <views:ConnectionProgressView
                    DataContext="{Binding Progress}"
                    Foreground="#E0E0E0"
                    Visibility="{Binding Progress.IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!-- Direct connections (no tunnel steps): plain spinner. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{Binding Progress.IsActive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <ProgressRing IsActive="True" Width="32" Height="32" />
                    <TextBlock Text="Connecting..."
                               HorizontalAlignment="Center"
                               Foreground="#e0e0e0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="#CC20242f"
                BorderBrush="#4456677a"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,6"
                Margin="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                MaxWidth="360"
                IsHitTestVisible="False"
                Visibility="{Binding IsWaitingForRemoteOutput, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Connected. Waiting for remote shell output..."
                       TextWrapping="Wrap"
                       Foreground="#e0e0e0"
                       FontSize="12" />
        </Border>

        <Border Background="#0c0c0c"
                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="480"
                        Padding="24">
                <!-- For a tunneled failure, show which numbered phase broke (red ✗). Hidden for
                     direct connections and post-connect drops (no failed step). Header is blanked
                     so it doesn't say "Connecting…" above a "Connection failed" message. -->
                <views:ConnectionProgressView
                    DataContext="{Binding Progress}"
                    Foreground="#E0E0E0"
                    Header=""
                    Margin="0,0,0,4"
                    Visibility="{Binding Progress.HasFailedStep, Converter={StaticResource BoolToVisibilityConverter}}" />
                <FontIcon Glyph="&#xE783;" FontSize="32" Foreground="#FF6B6B"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Connection failed"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="#e0e0e0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="#e0e0e0"
                           Opacity="0.85" />
                <Button Content="Retry"
                        Command="{Binding RetryCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
