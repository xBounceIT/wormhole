<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Sessions.RdpSurfaceHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sessions="using:Wormhole.ViewModels.Sessions">

    <Grid>
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Disconnect"
                                Command="{Binding DisconnectCommand}"
                                IsEnabled="{Binding CanDisconnect}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8BB;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Reconnect"
                                Command="{Binding RetryCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open in System Remote Desktop"
                                Command="{Binding UseExternalClientCommand}"
                                IsEnabled="{Binding CanUseExternalClient}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Reserved layout slot for the RDP host. The actual native surface is a SEPARATE
             TOP-LEVEL window owned by the WinUI main window, positioned in SCREEN physical
             pixels via MoveWindow from the code-behind (RdpSurfaceHost.ComputeBoundsScreenPx)
             on every size/move/DPI tick. This Grid stays empty visually but is the
             size/position anchor the overlay tracks.

             NOTE: the overlay is composited by DWM ABOVE the WinUI content (that is the whole
             point — reparenting it INTO this window as a WS_CHILD put it BEHIND the XAML
             DirectComposition surface, the WinUI 3 "airspace" problem, and the tab showed only
             the window background). Because of that, while CONNECTED the overlay intercepts
             pointer events over this slot — right-click goes to the remote desktop (as expected
             for RDP), NOT to the ContextFlyout below; the session actions (Disconnect / Open in
             System Remote Desktop) are therefore also surfaced on the tab context menu. The
             ContextFlyout below still works in the non-connected states, where the overlay is
             hidden and the WinUI status overlays receive the right-click. Background stays
             Transparent (not an opaque brush, not {x:Null}, which would disable hit-testing) so
             those non-connected right-clicks still reach it. -->
        <Grid x:Name="HostSurface"
              Background="Transparent"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />

        <!-- Connecting overlay -->
        <Grid x:Name="ConnectingOverlay"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="320">
                <ProgressRing IsActive="True" Width="32" Height="32" />
                <TextBlock Text="Connecting…"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ReconnectAttemptText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Opacity="0.7"
                           Visibility="Collapsed" />
                <Button Content="Cancel"
                        Command="{Binding DisconnectCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Failure overlay -->
        <Grid x:Name="FailedOverlay"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        MaxWidth="420">
                <FontIcon Glyph="&#xE783;" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="Connection failed"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Opacity="0.8"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button Content="Retry"
                            Command="{Binding RetryCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Open in System Remote Desktop"
                            Command="{Binding UseExternalClientCommand}"
                            IsEnabled="{Binding CanUseExternalClient}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Disconnected overlay -->
        <Grid x:Name="DisconnectedOverlay"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        MaxWidth="420">
                <FontIcon Glyph="&#xE711;" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="Disconnected"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button Content="Reconnect"
                            Command="{Binding RetryCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Open in System Remote Desktop"
                            Command="{Binding UseExternalClientCommand}"
                            IsEnabled="{Binding CanUseExternalClient}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- External client overlay -->
        <Grid x:Name="ExternalClientOverlay"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{Binding IsExternalClientActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        MaxWidth="440">
                <FontIcon Glyph="&#xE8A7;" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="Opened in System Remote Desktop"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button Content="Reconnect"
                            Command="{Binding RetryCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Disconnect"
                            Command="{Binding DisconnectCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
