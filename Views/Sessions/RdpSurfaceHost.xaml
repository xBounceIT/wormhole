<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Sessions.RdpSurfaceHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sessions="using:Wormhole.ViewModels.Sessions">

    <Grid>
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Disconnect"
                                Command="{Binding DisconnectCommand}"
                                IsEnabled="{Binding CanDisconnect}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8BB;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Reconnect"
                                Command="{Binding RetryCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open in System Remote Desktop"
                                Command="{Binding UseExternalClientCommand}"
                                IsEnabled="{Binding CanUseExternalClient}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Reserved layout slot for the reparented WinForms+ActiveX host. The actual native
             child window is positioned in window-client physical pixels via MoveWindow from
             the code-behind on every LayoutUpdated tick. This Grid stays empty visually but
             is the size/position anchor.

             Background MUST be Transparent (not an opaque brush, and not {x:Null}). WinUI 3
             renders XAML through DirectComposition, and an opaque Grid Background paints a
             composition surface that occludes the reparented child HWND beneath it — the
             symptom is a solid rectangle in the slot's brush color instead of the OCX paint
             output. A Transparent brush solves that (DComp does not occlude through alpha=0
             pixels) AND keeps the slot hit-testable so right-click on empty regions of the
             surface still bubbles to the parent Grid's ContextFlyout (Disconnect / Reconnect
             / Open in System Remote Desktop). {x:Null} would also be visually transparent
             but disables hit-testing entirely. -->
        <Grid x:Name="HostSurface"
              Background="Transparent"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />

        <!-- Connecting overlay -->
        <Grid x:Name="ConnectingOverlay"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="320">
                <ProgressRing IsActive="True" Width="32" Height="32" />
                <TextBlock Text="Connecting…"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ReconnectAttemptText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Opacity="0.7"
                           Visibility="Collapsed" />
                <Button Content="Cancel"
                        Command="{Binding DisconnectCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Failure overlay -->
        <Grid x:Name="FailedOverlay"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        MaxWidth="420">
                <FontIcon Glyph="&#xE783;" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="Connection failed"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Opacity="0.8"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button Content="Retry"
                            Command="{Binding RetryCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Open in System Remote Desktop"
                            Command="{Binding UseExternalClientCommand}"
                            IsEnabled="{Binding CanUseExternalClient}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Disconnected overlay -->
        <Grid x:Name="DisconnectedOverlay"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        MaxWidth="420">
                <FontIcon Glyph="&#xE711;" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="Disconnected"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button Content="Reconnect"
                            Command="{Binding RetryCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Open in System Remote Desktop"
                            Command="{Binding UseExternalClientCommand}"
                            IsEnabled="{Binding CanUseExternalClient}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- External client overlay -->
        <Grid x:Name="ExternalClientOverlay"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{Binding IsExternalClientActive, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        MaxWidth="440">
                <FontIcon Glyph="&#xE8A7;" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="Opened in System Remote Desktop"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button Content="Reconnect"
                            Command="{Binding RetryCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Disconnect"
                            Command="{Binding DisconnectCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
