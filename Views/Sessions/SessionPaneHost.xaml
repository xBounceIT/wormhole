<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Sessions.SessionPaneHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wormhole.Views.Sessions"
    AllowDrop="True"
    DragOver="OnPaneDragOver"
    DragLeave="OnPaneDragLeave"
    Drop="OnPaneDrop">

    <!--
      Per-pane connection strip (mRemoteNG-style). Actions live inside the tab chip —
      same pattern as the global TabView header — not as loose buttons on the row.
    -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ConnectionHeader"
                Grid.Row="0"
                Visibility="Collapsed"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,4,4,0"
                AllowDrop="True"
                DragOver="OnConnectionHeaderDragOver"
                DragLeave="OnConnectionHeaderDragLeave"
                Drop="OnConnectionHeaderDrop"
                Tapped="OnHeaderTapped"
                DoubleTapped="OnHeaderDoubleTapped">
            <Border.ContextFlyout>
                <MenuFlyout x:Name="HeaderContextFlyout"
                            Opened="OnHeaderContextFlyoutOpened"
                            Closed="OnHeaderContextFlyoutClosed">
                    <MenuFlyoutItem x:Name="DuplicateItem"
                                    Text="Duplicate"
                                    Click="OnDuplicateClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="ReconnectItem"
                                    Text="Reconnect"
                                    Click="OnReconnectClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="FileTransferItem"
                                    Text="File transfer"
                                    Click="OnFileTransferClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8AB;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="DisconnectItem"
                                    Text="Disconnect">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="ExternalClientItem"
                                    Text="Open in System Remote Desktop">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="RestoreItem"
                                    Text="Restore full view"
                                    Click="OnRestoreClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE740;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Close" Click="OnCloseClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE894;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>

            <!-- Tab chip: title + SFTP + close (mirrors TabViewItem.Header) -->
            <Border x:Name="TitleChip"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4,4,0,0"
                    Padding="8,2,2,2"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    MaxWidth="320"
                    PointerPressed="OnChipPointerPressed"
                    PointerMoved="OnChipPointerMoved"
                    PointerReleased="OnChipPointerReleased"
                    PointerCaptureLost="OnChipPointerCaptureLost"
                    DragStarting="OnHeaderDragStarting">
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText"
                               Grid.Column="0"
                               Margin="4,0,4,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />

                    <Button x:Name="FileTransferButton"
                            Grid.Column="1"
                            Padding="4"
                            MinWidth="28"
                            MinHeight="28"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="File transfer"
                            Click="OnFileTransferClick">
                        <FontIcon Glyph="&#xE8AB;" FontSize="12" />
                    </Button>

                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Padding="4"
                            MinWidth="28"
                            MinHeight="28"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Close"
                            Click="OnCloseClick">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
        </Border>

        <local:SessionDropOverlay x:Name="DropOverlay" Grid.Row="1" />
    </Grid>
</UserControl>
