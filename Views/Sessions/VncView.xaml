<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Sessions.VncView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Wormhole.Views.Sessions"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    KeyUp="OnKeyUp">

    <Grid Background="#0c0c0c"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          MinHeight="240">
        <Grid x:Name="FramebufferHost"
              Background="#0c0c0c"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              PointerPressed="OnPointerPressed"
              PointerReleased="OnPointerReleased"
              PointerMoved="OnPointerMoved"
              PointerWheelChanged="OnPointerWheelChanged"
              PointerCanceled="OnPointerCanceled"
              PointerCaptureLost="OnPointerCaptureLost"
              PointerExited="OnPointerExited">
            <Image x:Name="FramebufferImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsHitTestVisible="False" />
            <TextBlock x:Name="WaitingFrameText"
                       Text="Waiting for remote framebuffer..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#e0e0e0"
                       Opacity="0.7" />
        </Grid>

        <Border Background="#0c0c0c"
                IsHitTestVisible="False"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

        <Border Background="#0c0c0c"
                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <views:ConnectionProgressView
                    DataContext="{Binding Progress}"
                    Foreground="#E0E0E0"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Visibility="{Binding Progress.IsActive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <ProgressRing IsActive="True" Width="32" Height="32" />
                    <TextBlock Text="Connecting..."
                               HorizontalAlignment="Center"
                               Foreground="#e0e0e0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Background="#0c0c0c"
                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="480"
                        Padding="24">
                <views:ConnectionProgressView
                    DataContext="{Binding Progress}"
                    Foreground="#E0E0E0"
                    Header=""
                    Margin="0,0,0,4"
                    Visibility="{Binding HasFailedStep, Converter={StaticResource BoolToVisibilityConverter}}" />
                <FontIcon Glyph="&#xE783;"
                          FontSize="32"
                          Foreground="#FF6B6B"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Connection failed"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="#e0e0e0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="#e0e0e0"
                           Opacity="0.85" />
                <Button Content="Retry"
                        Command="{Binding RetryCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
