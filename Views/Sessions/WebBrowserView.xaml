<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Sessions.WebBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Wormhole.Views.Sessions">

    <Grid Background="#0c0c0c"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Browser toolbar: only shown once the page is loaded, so a connecting/failed tab isn't
             topped by an empty bar (the Auto row collapses when hidden). -->
        <Grid Grid.Row="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Padding="6,4"
              ColumnSpacing="4"
              Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0"
                    Click="OnBackClick"
                    Style="{StaticResource IconButtonStyle}"
                    Padding="6" MinWidth="0" MinHeight="0">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1"
                    Click="OnForwardClick"
                    Style="{StaticResource IconButtonStyle}"
                    Padding="6" MinWidth="0" MinHeight="0">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button x:Name="ReloadButton" Grid.Column="2"
                    Click="OnReloadClick"
                    Style="{StaticResource IconButtonStyle}"
                    Padding="6" MinWidth="0" MinHeight="0">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button x:Name="BitwardenButton" Grid.Column="3"
                    Click="OnBitwardenClick"
                    Style="{StaticResource IconButtonStyle}"
                    Padding="6" MinWidth="0" MinHeight="0"
                    Visibility="Collapsed">
                <Grid Width="16" Height="16">
                    <Image x:Name="BitwardenIconImage"
                           Width="16"
                           Height="16"
                           Stretch="Uniform" />
                    <FontIcon x:Name="BitwardenFallbackIcon"
                              Glyph="&#xE192;"
                              FontSize="14"
                              Foreground="#175DDC"
                              Visibility="Collapsed" />
                </Grid>
            </Button>
            <TextBlock x:Name="AddressText" Grid.Column="4"
                       VerticalAlignment="Center"
                       Margin="6,0,4,0"
                       Opacity="0.8"
                       IsTextSelectionEnabled="True"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1">
            <!-- The WebView2 control is created in code-behind (its environment — including any SOCKS5
                 proxy — must be chosen at creation time from the resolved connection target) and added here. -->
            <Grid x:Name="WebViewHost"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch" />

            <!-- Base cover: opaque whenever NOT Connected, so the WebView2's prior page can't flash
                 through during Connecting/Failed transitions (mirrors SshTerminalView). -->
            <Border Background="#0c0c0c"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

            <!-- Connecting overlay: phased stepper for tunneled connections, plain spinner otherwise. -->
            <Border Background="#0c0c0c"
                    Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <views:ConnectionProgressView
                        DataContext="{Binding Progress}"
                        Foreground="#E0E0E0"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                Visibility="{Binding Progress.IsActive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <ProgressRing IsActive="True" Width="32" Height="32" />
                        <TextBlock Text="Connecting..."
                                   HorizontalAlignment="Center"
                                   Foreground="#e0e0e0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Failure overlay with Retry. -->
            <Border Background="#0c0c0c"
                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="480"
                            Padding="24">
                    <views:ConnectionProgressView
                        DataContext="{Binding Progress}"
                        Foreground="#E0E0E0"
                        Header=""
                        Margin="0,0,0,4"
                        Visibility="{Binding HasFailedStep, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <FontIcon Glyph="&#xE783;" FontSize="32" Foreground="#FF6B6B"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Connection failed"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="#e0e0e0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="#e0e0e0"
                               Opacity="0.85" />
                    <Button Content="Retry"
                            Command="{Binding RetryCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Background="#0c0c0c"
                    Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            MaxWidth="420"
                            Padding="24">
                    <FontIcon Glyph="&#xE711;"
                              FontSize="32"
                              Foreground="#e0e0e0"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Disconnected"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="#e0e0e0"
                               HorizontalAlignment="Center" />
                    <Button Content="Reconnect"
                            Command="{Binding RetryCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
