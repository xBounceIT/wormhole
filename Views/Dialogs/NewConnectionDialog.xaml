<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wormhole.Views.Dialogs.NewConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wormhole.Models"
    Title="New connection"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    Opened="OnOpened"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBox x:Name="NameBox"
                 Header="Name"
                 PlaceholderText="prod-web"
                 TextChanged="OnFieldChanged" />

        <ComboBox x:Name="ProtocolBox"
                  Header="Protocol"
                  ItemsSource="{x:Bind Protocols}"
                  SelectedIndex="0"
                  HorizontalAlignment="Stretch" />

        <TextBox x:Name="HostBox"
                 Header="Host"
                 PlaceholderText="example.com"
                 TextChanged="OnFieldChanged" />

        <NumberBox x:Name="PortBox"
                   Header="Port"
                   PlaceholderText="Default for protocol"
                   Minimum="1"
                   Maximum="65535"
                   SpinButtonPlacementMode="Hidden" />

        <TextBox x:Name="UsernameBox"
                 Header="Username"
                 PlaceholderText="(optional)" />
    </StackPanel>
</ContentDialog>
