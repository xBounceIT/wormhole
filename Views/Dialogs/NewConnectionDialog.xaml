<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Dialogs.NewConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wormhole.Models"
    xmlns:viewModels="using:Wormhole.ViewModels"
    xmlns:sys="using:System"
    xmlns:collections="using:System.Collections.Generic">

    <UserControl.Resources>
        <Thickness x:Key="FieldRowMargin">0,0,0,8</Thickness>
        <DataTemplate x:Key="CredentialItemTemplate" x:DataType="models:CredentialProfile">
            <TextBlock Text="{Binding Converter={StaticResource CredentialProfileDisplayConverter}}" />
        </DataTemplate>
        <DataTemplate x:Key="TunnelItemTemplate" x:DataType="models:TunnelConfig">
            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
        </DataTemplate>
    </UserControl.Resources>

    <TabView x:Name="EditorTabs"
             IsAddTabButtonVisible="False"
             CanDragTabs="False"
             CanReorderTabs="False"
             TabWidthMode="SizeToContent"
             MinWidth="540"
             MinHeight="380">

            <!-- General -->
            <TabViewItem Header="General" IsClosable="False">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="10">
                        <TextBox x:Name="NameBox"
                                 Header="Name"
                                 PlaceholderText="prod-web"
                                 Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Protocol, Host and Port share one row to keep the form compact. -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ProtocolBox"
                                      Grid.Column="0"
                                      Header="Protocol"
                                      MinWidth="110"
                                      ItemsSource="{x:Bind Protocols}"
                                      SelectedItem="{x:Bind ViewModel.Protocol, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProtocolType">
                                        <TextBlock Text="{x:Bind Converter={StaticResource ToUpperConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBox x:Name="HostBox"
                                     Grid.Column="1"
                                     Header="{x:Bind ViewModel.HostHeader, Mode=OneWay}"
                                     PlaceholderText="{x:Bind ViewModel.HostPlaceholder, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <NumberBox Grid.Column="2"
                                       Header="Port"
                                       MinWidth="96"
                                       PlaceholderText="Default"
                                       Minimum="1"
                                       Maximum="65535"
                                       SpinButtonPlacementMode="Hidden"
                                       Visibility="{x:Bind ViewModel.ShowPortBox, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Value="{x:Bind PortBindable, Mode=TwoWay, FallbackValue=NaN}" />
                        </Grid>

                        <!-- Web (HTTP/HTTPS): the address field above carries an optional port. -->
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Text="Enter the host or IP. Include a port if the appliance uses a non-standard one, e.g. 10.0.0.1:8443."
                                   Visibility="{x:Bind ViewModel.IsHttp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <InfoBar Severity="Error"
                                 IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.IsHttpAddressErrorOpen, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.HttpAddressError, Mode=OneWay}" />

                        <!-- HTTPS only: appliance management GUIs commonly serve self-signed certificates. -->
                        <CheckBox Content="Ignore certificate errors"
                                  IsChecked="{x:Bind ViewModel.HttpIgnoreCertErrors, Mode=TwoWay}"
                                  Visibility="{x:Bind ViewModel.IsHttps, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="0,-4,0,0"
                                   Text="Accept self-signed or otherwise untrusted certificates — typical for firewall and appliance GUIs."
                                   Visibility="{x:Bind ViewModel.IsHttps, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Credentials (SSH/RDP). Hidden entirely for the credential-less web protocols. -->
                        <StackPanel Spacing="10"
                                    Visibility="{x:Bind ViewModel.ShowCredentialSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!-- Credential mode toggle: a saved credential (checked) OR an inline
                             username + password (unchecked). Pure x:Bind drives both panels'
                             visibility, so there is no code-behind toggle handler (which would
                             risk the WinUI init-event NRE on later-declared x:Name elements). -->
                        <CheckBox Content="Use saved credentials"
                                  IsChecked="{x:Bind ViewModel.UseSavedCredentials, Mode=TwoWay}" />

                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.UseSavedCredentials, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Saved credentials"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <AutoSuggestBox x:Name="CredentialBox"
                                            HorizontalAlignment="Stretch"
                                            PlaceholderText="Inherit from folder"
                                            QueryIcon="Find"
                                            TextMemberPath="Name"
                                            ItemTemplate="{StaticResource CredentialItemTemplate}"
                                            TextChanged="OnCredentialTextChanged"
                                            QuerySubmitted="OnCredentialQuerySubmitted"
                                            GotFocus="OnCredentialGotFocus"
                                            LostFocus="OnCredentialLostFocus" />
                        </StackPanel>

                        <TextBox Header="Username"
                                 PlaceholderText="(optional)"
                                 Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{x:Bind ViewModel.UseSavedCredentials, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <!-- Inline password is SSH-only (ShowInlinePassword = IsSsh AND not using a
                             saved credential). Stored in Credential Manager keyed by the node Id.
                             PasswordBox.Password isn't x:Bind-able, so it syncs via a code-behind
                             PasswordChanged handler. -->
                        <PasswordBox x:Name="InlinePasswordBox"
                                     Header="Password"
                                     PlaceholderText="(optional)"
                                     PasswordChanged="OnInlinePasswordChanged"
                                     Visibility="{x:Bind ViewModel.ShowInlinePassword, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Hidden once a real saved RDP credential is picked: that credential
                             already carries a (mandatory) domain, so a node-level Domain box would
                             only duplicate/override it — same reason the Username box hides above.
                             Still shown for inline/prompt and "(None) — prompt every time" (the
                             AzureAD workflow needs a place to type the domain). See ShowRdpDomain. -->
                        <TextBox Header="Domain"
                                 PlaceholderText="WORKGROUP"
                                 Text="{x:Bind ViewModel.RdpDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{x:Bind ViewModel.ShowRdpDomain, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.CanUseSshAutoSudo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Auto sudo"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <ComboBox HorizontalAlignment="Left"
                                      MinWidth="240"
                                      ItemsSource="{x:Bind ViewModel.SshAutoSudoChoices}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      SelectedValue="{x:Bind ViewModel.SshAutoSudoMode, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"
                                       Text="{x:Bind ViewModel.SshAutoSudoDescription, Mode=OneWay}" />
                        </StackPanel>
                        </StackPanel>
                        <!-- /Credentials (SSH/RDP) -->

                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.ShowTunnelSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="VPN tunnel"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.TunnelPicker.AvailableTunnelConfigs}"
                                      ItemTemplate="{StaticResource TunnelItemTemplate}"
                                      SelectedItem="{x:Bind ViewModel.TunnelPicker.SelectedTunnel, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"
                                       Text="Started before the target connection. &quot;Inherit from folder&quot; follows the parent folder's tunnel setting; &quot;No tunnel&quot; overrides any inherited tunnel." />
                        </StackPanel>

                        <InfoBar Severity="Informational"
                                 IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.IsAzureAdCredential, Mode=OneWay}"
                                 Title="Azure AD target"
                                 Message="Wormhole detected an Azure AD signal (credential, username, or domain) and will open this connection in the system Remote Desktop client (mstsc.exe). The embedded host can't load the WAM broker in our unpackaged build and crashes mid-handshake on AAD auth — for safety, this routing is enforced even if you uncheck the box below." />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Serial -->
            <TabViewItem Header="Serial" IsClosable="False"
                         Visibility="{x:Bind ViewModel.IsSerial, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Header="Speed (baud)"
                                       MinWidth="160"
                                       HorizontalAlignment="Left"
                                       Minimum="1"
                                       Maximum="4000000"
                                       SmallChange="1200"
                                       LargeChange="9600"
                                       SpinButtonPlacementMode="Hidden"
                                       IsEnabled="{x:Bind ViewModel.SerialBaudRateInherits, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                       Value="{x:Bind SerialBaudRateBindable, Mode=TwoWay, FallbackValue=9600}" />
                            <CheckBox Grid.Column="1"
                                      Content="Inherit"
                                      VerticalAlignment="Bottom"
                                      IsChecked="{x:Bind ViewModel.SerialBaudRateInherits, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Data bits"
                                      HorizontalAlignment="Left"
                                      MinWidth="160"
                                      ItemsSource="{x:Bind ViewModel.SerialDataBitChoices}"
                                      IsEnabled="{x:Bind ViewModel.SerialDataBitsInherits, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                      SelectedItem="{x:Bind ViewModel.SerialDataBits, Mode=TwoWay}" />
                            <CheckBox Grid.Column="1"
                                      Content="Inherit"
                                      VerticalAlignment="Bottom"
                                      IsChecked="{x:Bind ViewModel.SerialDataBitsInherits, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Stop bits"
                                      HorizontalAlignment="Left"
                                      MinWidth="160"
                                      ItemsSource="{x:Bind ViewModel.SerialStopBitChoices}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      IsEnabled="{x:Bind ViewModel.SerialStopBitsInherits, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                      SelectedValue="{x:Bind ViewModel.SerialStopBits, Mode=TwoWay}" />
                            <CheckBox Grid.Column="1"
                                      Content="Inherit"
                                      VerticalAlignment="Bottom"
                                      IsChecked="{x:Bind ViewModel.SerialStopBitsInherits, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Parity"
                                      HorizontalAlignment="Left"
                                      MinWidth="160"
                                      ItemsSource="{x:Bind ViewModel.SerialParityChoices}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      IsEnabled="{x:Bind ViewModel.SerialParityInherits, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                      SelectedValue="{x:Bind ViewModel.SerialParity, Mode=TwoWay}" />
                            <CheckBox Grid.Column="1"
                                      Content="Inherit"
                                      VerticalAlignment="Bottom"
                                      IsChecked="{x:Bind ViewModel.SerialParityInherits, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Flow control"
                                      HorizontalAlignment="Left"
                                      MinWidth="180"
                                      ItemsSource="{x:Bind ViewModel.SerialFlowControlChoices}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      IsEnabled="{x:Bind ViewModel.SerialFlowControlInherits, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                      SelectedValue="{x:Bind ViewModel.SerialFlowControl, Mode=TwoWay}" />
                            <CheckBox Grid.Column="1"
                                      Content="Inherit"
                                      VerticalAlignment="Bottom"
                                      IsChecked="{x:Bind ViewModel.SerialFlowControlInherits, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Display (RDP) -->
            <TabViewItem Header="Display" IsClosable="False"
                         Visibility="{x:Bind ViewModel.IsRdp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="10">
                        <ComboBox Header="Display configuration"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Full connection content"
                                  ItemsSource="{x:Bind ViewModel.ScreenSizeChoices}"
                                  SelectedItem="{x:Bind ViewModel.RdpScreenSize, Mode=TwoWay}" />

                        <ComboBox Header="Color depth"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.ColorDepthChoices}"
                                  SelectedItem="{x:Bind ViewModel.RdpColorDepth, Mode=TwoWay}" />

                        <CheckBox Content="Use all my monitors"
                                  IsChecked="{x:Bind ViewModel.RdpUseAllMonitors, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Local Resources (RDP) -->
            <TabViewItem Header="Local Resources" IsClosable="False"
                         Visibility="{x:Bind ViewModel.IsRdp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="12">
                        <ComboBox Header="Remote audio playback"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.AudioModeChoices}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  SelectedValue="{x:Bind ViewModel.RdpAudioMode, Mode=TwoWay}" />

                        <ComboBox Header="Remote audio recording"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.AudioCaptureChoices}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  SelectedValue="{x:Bind ViewModel.RdpAudioCaptureMode, Mode=TwoWay}" />

                        <ComboBox Header="Apply Windows key combinations"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.KeyboardHookChoices}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  SelectedValue="{x:Bind ViewModel.RdpKeyboardHookMode, Mode=TwoWay}" />

                        <TextBlock Text="Local devices and resources"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,8,0,0" />
                        <CheckBox Content="Clipboard"
                                  IsChecked="{x:Bind ViewModel.RdpRedirectClipboard, Mode=TwoWay}" />
                        <CheckBox Content="Printers"
                                  IsChecked="{x:Bind ViewModel.RdpRedirectPrinters, Mode=TwoWay}" />
                        <CheckBox Content="Smart cards"
                                  IsChecked="{x:Bind ViewModel.RdpRedirectSmartCards, Mode=TwoWay}" />
                        <CheckBox Content="Serial / parallel ports"
                                  IsChecked="{x:Bind ViewModel.RdpRedirectPorts, Mode=TwoWay}" />
                        <CheckBox Content="Other Plug and Play devices"
                                  IsChecked="{x:Bind ViewModel.RdpRedirectDevices, Mode=TwoWay}" />

                        <TextBlock Text="Drives"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,8,0,0" />
                        <RadioButton Content="Do not redirect drives"
                                     GroupName="DriveRedirect"
                                     IsChecked="{x:Bind ViewModel.RdpDriveRedirectMode, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=none}" />
                        <RadioButton Content="Redirect all drives"
                                     GroupName="DriveRedirect"
                                     IsChecked="{x:Bind ViewModel.RdpDriveRedirectMode, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=all}" />
                        <RadioButton Content="Choose drives by letter"
                                     GroupName="DriveRedirect"
                                     IsChecked="{x:Bind ViewModel.RdpDriveRedirectMode, Mode=TwoWay, Converter={StaticResource StringEqualsConverter}, ConverterParameter=custom}" />
                        <TextBox PlaceholderText="C,D,E"
                                 Margin="22,0,0,0"
                                 Text="{x:Bind ViewModel.RdpCustomDriveList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.IsCustomDriveList, Mode=OneWay}" />
                        <InfoBar Severity="Error"
                                 IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.IsCustomDriveListErrorOpen, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.CustomDriveListError, Mode=OneWay}"
                                 Margin="22,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Experience (RDP) -->
            <TabViewItem Header="Experience" IsClosable="False"
                         Visibility="{x:Bind ViewModel.IsRdp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="10">
                        <ComboBox Header="Connection speed"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.ConnectionSpeedChoices}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  SelectedValue="{x:Bind ViewModel.RdpConnectionSpeed, Mode=TwoWay}" />

                        <TextBlock Text="Allow the following:"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,8,0,0" />
                        <CheckBox Content="Desktop background"
                                  IsChecked="{x:Bind ViewModel.RdpDesktopBackground, Mode=TwoWay}" />
                        <CheckBox Content="Font smoothing"
                                  IsChecked="{x:Bind ViewModel.RdpFontSmoothing, Mode=TwoWay}" />
                        <CheckBox Content="Desktop composition"
                                  IsChecked="{x:Bind ViewModel.RdpDesktopComposition, Mode=TwoWay}" />
                        <CheckBox Content="Show contents of window while dragging"
                                  IsChecked="{x:Bind ViewModel.RdpWindowDrag, Mode=TwoWay}" />
                        <CheckBox Content="Menu and window animation"
                                  IsChecked="{x:Bind ViewModel.RdpMenuAnimation, Mode=TwoWay}" />
                        <CheckBox Content="Visual styles"
                                  IsChecked="{x:Bind ViewModel.RdpVisualStyles, Mode=TwoWay}" />
                        <CheckBox Content="Persistent bitmap caching"
                                  IsChecked="{x:Bind ViewModel.RdpBitmapCaching, Mode=TwoWay}" />

                        <CheckBox Content="Reconnect if the connection is dropped"
                                  IsChecked="{x:Bind ViewModel.RdpAutoReconnect, Mode=TwoWay}"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Advanced (RDP) -->
            <TabViewItem Header="Advanced" IsClosable="False"
                         Visibility="{x:Bind ViewModel.IsRdp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer Padding="16">
                    <StackPanel Spacing="10">
                        <ComboBox Header="Server authentication"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.ServerAuthChoices}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  SelectedValue="{x:Bind ViewModel.RdpServerAuthentication, Mode=TwoWay}" />

                        <TextBlock Text="Connect from anywhere (RD Gateway)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,8,0,0" />
                        <ComboBox Header="Use these settings"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.GatewayUsageChoices}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  SelectedValue="{x:Bind ViewModel.RdpGatewayUsageMethod, Mode=TwoWay}" />
                        <TextBox Header="Server name"
                                 PlaceholderText="gateway.example.com"
                                 Text="{x:Bind ViewModel.RdpGatewayHostname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.IsGatewayEnabled, Mode=OneWay}" />
                        <InfoBar Severity="Error"
                                 IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.IsGatewayHostnameErrorOpen, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.GatewayHostnameError, Mode=OneWay}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Gateway credentials"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <AutoSuggestBox x:Name="GatewayCredentialBox"
                                            HorizontalAlignment="Stretch"
                                            PlaceholderText="Prompt every time"
                                            QueryIcon="Find"
                                            TextMemberPath="Name"
                                            ItemTemplate="{StaticResource CredentialItemTemplate}"
                                            TextChanged="OnGatewayCredentialTextChanged"
                                            QuerySubmitted="OnGatewayCredentialQuerySubmitted"
                                            GotFocus="OnGatewayCredentialGotFocus"
                                            LostFocus="OnGatewayCredentialLostFocus"
                                            IsEnabled="{x:Bind ViewModel.IsGatewayEnabled, Mode=OneWay}" />
                        </StackPanel>
                        <CheckBox Content="Use my RD Gateway credentials for the remote computer"
                                  IsChecked="{x:Bind ViewModel.RdpGatewayUseSameCreds, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsGatewayEnabled, Mode=OneWay}" />
                        <CheckBox Content="Bypass RD Gateway for local addresses"
                                  IsChecked="{x:Bind ViewModel.RdpGatewayBypassLocal, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsGatewayEnabled, Mode=OneWay}" />

                        <TextBlock Text="Client"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,8,0,0" />
                        <CheckBox Content="Open with system Remote Desktop (mstsc.exe)"
                                  IsChecked="{x:Bind ViewModel.RdpUseExternalClient, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsRdpUseExternalClientEditable, Mode=OneWay}" />
                        <TextBlock Text="Manual opt-in for non-AAD targets — e.g. a flaky embedded session you'd rather run via the system client. AAD targets are handled automatically (see banner on the General tab)."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Locked on for Azure AD targets. The embedded host's WAM delay-load crashes the process unrecoverably, so Wormhole forces mstsc.exe regardless of this checkbox."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.IsAzureAdCredential, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
    </TabView>
</UserControl>
