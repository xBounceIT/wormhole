<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Dialogs.BackupExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wormhole.Views.Dialogs">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  MaxHeight="560"
                  MinWidth="480">
        <StackPanel Spacing="12" Padding="0,0,12,0">

            <TextBlock TextWrapping="Wrap">
                Backup includes the entire connections tree, credentials (with passwords),
                SSH private keys, and VPN tunnel configurations. The file is portable
                between machines and Windows user accounts.
            </TextBlock>

            <TextBlock Text="Destination"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="0,8,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         IsReadOnly="True"
                         PlaceholderText="No file selected"
                         Header="Backup file (.json)"
                         Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}" />
                <Button Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Content="Choose location..."
                        IsEnabled="{x:Bind ViewModel.CanPickFile, Mode=OneWay}"
                        Click="OnPickFile" />
                <Button Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Content="Export"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.StartExportCommand}" />
            </Grid>

            <TextBlock Text="Encryption (optional)"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="0,8,0,0" />
            <PasswordBox x:Name="PasswordInput"
                         Header="Password"
                         PasswordChanged="OnPasswordChanged"
                         PlaceholderText="Leave blank to write plaintext JSON" />
            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Warning"
                     Title="Plaintext warning"
                     Message="With no password, the file will contain every credential and private key in plaintext. Anyone with the file can read them."
                     Visibility="{x:Bind local:BackupExportDialog.PlaintextWarningVisibility(ViewModel.Password, ViewModel.HasResult, ViewModel.IsBusy, ViewModel.Status), Mode=OneWay}" />

            <!-- Progress -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar Value="{x:Bind ViewModel.Percent, Mode=OneWay}" Minimum="0" Maximum="100" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CancelCommand}" />
                </Grid>
            </StackPanel>

            <!-- Result -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Success"
                     Title="Backup complete"
                     Message="{x:Bind ViewModel.Status, Mode=OneWay}" />

            <!-- Out-of-band status for cancel/error states. -->
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind local:BackupExportDialog.OutOfBandStatusVisibility(ViewModel.Status, ViewModel.IsBusy, ViewModel.HasResult), Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
