<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Dialogs.TunnelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wormhole.Models">

    <!-- Horizontal 2-column layout: Name + VPN type share the top row, and each kind panel
         splits into two side-by-side sections. ContentDialog hosts this at ~760 px (see
         PreferredDialogMinWidth in the code-behind) and clamps narrower if the host window
         can't fit it (DialogService applies Math.Min against XamlRoot.Size).
         The ScrollViewer intentionally has NO MinWidth so it shrinks with the dialog's
         inner content area (which is ~712 px after the default ~24 px chrome padding on a
         760 px dialog). HorizontalScrollMode=Disabled because TextBoxes don't wrap and the
         columns shrink with the Grid's `*` widths — narrowing is preferable to a horizontal
         scrollbar that hides input chrome. MaxHeight ≈ the tallest panel (OpenVPN's profile
         320 + auth row + headers, ~518 px); VerticalScrollMode=Enabled absorbs any future
         growth instead of clipping. Padding="0,0,12,0" reserves space for the scrollbar. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  MaxHeight="520">
    <StackPanel Spacing="14" Padding="0,0,12,0">
        <!-- Live "why is Create disabled" hint. A ContentDialog only exposes a boolean
             IsPrimaryButtonEnabled (DialogService binds it to IDraftForm.IsValid), so without
             this the disabled Create button is a silent dead-end — most acute for Watchguard,
             whose required CA / client-cert / client-key fields live in the collapsed expander
             below. UpdateValidationHint() keeps this in sync with the per-kind required-field
             set on every edit. IsClosable=False: it is guidance, not a dismissible error, and
             auto-hides the moment the form is valid. -->
        <InfoBar x:Name="ValidationHintBar"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Informational" />
        <!-- Top row: Name and VPN type on a single horizontal line. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="NameBox"
                     Header="Name"
                     PlaceholderText="corp-vpn"
                     TextChanged="OnFieldChanged" />

            <ComboBox Grid.Column="1"
                      x:Name="KindBox"
                      Header="VPN type"
                      ItemsSource="{x:Bind Kinds}"
                      SelectedIndex="0"
                      SelectionChanged="OnKindChanged"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TunnelKind">
                        <TextBlock Text="{x:Bind}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- WireGuard fields: shown only when KindBox.SelectedItem == TunnelKind.WireGuard.
             Each tunnel kind owns its own panel with its own Visibility binding so the
             form section follows the selected Kind. Interface fields sit in the left
             column, Peer fields in the right column. -->
        <Grid x:Name="WireGuardPanel" ColumnSpacing="16" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="10">
                <TextBlock Text="Interface" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                <TextBox x:Name="InterfacePrivateKeyBox"
                         Header="Private key (base64)"
                         FontFamily="Consolas"
                         TextChanged="OnFieldChanged" />
                <TextBox x:Name="InterfaceAddressBox"
                         Header="Address (e.g. 10.0.0.2/32)"
                         TextChanged="OnFieldChanged" />
                <TextBox x:Name="MtuBox"
                         Header="MTU (optional)" />
                <TextBox x:Name="DnsBox"
                         Header="DNS (comma-separated, optional)" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock Text="Peer" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                <TextBox x:Name="PeerPublicKeyBox"
                         Header="Public key (base64)"
                         FontFamily="Consolas"
                         TextChanged="OnFieldChanged" />
                <TextBox x:Name="PeerPresharedKeyBox"
                         Header="Preshared key (base64, optional)"
                         FontFamily="Consolas" />
                <TextBox x:Name="PeerEndpointBox"
                         Header="Endpoint (host:port)"
                         TextChanged="OnFieldChanged" />
                <TextBox x:Name="AllowedIpsBox"
                         Header="Allowed IPs (comma-separated)"
                         PlaceholderText="leave blank to route all traffic (0.0.0.0/0, ::/0)" />
                <TextBox x:Name="PersistentKeepaliveBox"
                         Header="Persistent keepalive seconds (optional)" />
            </StackPanel>
        </Grid>

        <!-- OpenVPN fields: paste the full .ovpn profile (kept full-width because long lines
             read better unwrapped), plus optional auth-user-pass credentials kept out of
             the profile so they can be edited / rotated independently and stored alongside
             (DPAPI-encrypted) instead of inlined in the profile blob. -->
        <StackPanel x:Name="OpenVpnPanel" Spacing="10" Visibility="Collapsed">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Profile"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Import from file…"
                        ToolTipService.ToolTip="Load a .ovpn profile from disk"
                        Click="OnImportOvpnFile" />
            </Grid>
            <!-- Surfaces .ovpn import errors inline. Cannot use a nested ContentDialog
                 here because TunnelDialog itself is hosted in a ContentDialog and WinUI 3
                 forbids two open at the same XamlRoot. -->
            <InfoBar x:Name="OvpnImportErrorBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Error"
                     Title="Couldn't read file" />
            <TextBox x:Name="ProfileOvpnBox"
                     Header="OpenVPN profile (.ovpn contents)"
                     PlaceholderText="client&#x0a;proto udp&#x0a;remote vpn.example.com 1194&#x0a;..."
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     MinHeight="220"
                     MaxHeight="320"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     TextChanged="OnFieldChanged" />

            <TextBlock Text="Authentication (optional)" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         x:Name="OpenVpnUsernameBox"
                         Header="Username"
                         PlaceholderText="leave blank for certificate-only auth"
                         TextChanged="OnFieldChanged" />
                <PasswordBox Grid.Column="1"
                             x:Name="OpenVpnPasswordBox"
                             Header="Password"
                             PasswordChanged="OnPasswordFieldChanged" />
            </Grid>
        </StackPanel>

        <!-- Watchguard fields: Mobile VPN with SSL is OpenVPN over TCP/443 with a Firebox CA;
             server+credentials are the normal path, while domain/cert overrides live under
             Advanced. -->
        <StackPanel x:Name="WatchguardPanel" Spacing="10" Visibility="Collapsed">
            <Button x:Name="WatchguardImportButton"
                    Content="Import from .wgssl…"
                    Click="OnWatchguardImportClicked"
                    HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="Wormhole downloads the WatchGuard SSL VPN profile on connect. Importing a .wgssl profile is only needed as an advanced offline fallback." />
            <!-- Inline status bar for .wgssl import outcomes. We can't `ContentDialog.ShowAsync`
                 an error from here because the TunnelDialog itself is already a ContentDialog and
                 WinUI 3 only allows one ContentDialog per XamlRoot — the second ShowAsync would
                 throw silently. An InfoBar inside our panel sidesteps that constraint. -->
            <InfoBar x:Name="WatchguardImportStatus"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Error" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="10">
                    <TextBlock Text="Gateway" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                    <ComboBox x:Name="WatchguardAuthModeBox"
                              Header="Authentication mode"
                              ItemsSource="{x:Bind WatchguardAuthModes}"
                              SelectedIndex="0"
                              SelectionChanged="OnWatchguardAuthModeChanged"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:WatchguardAuthMode">
                                <TextBlock Text="{x:Bind}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox x:Name="WatchguardServerBox"
                             Header="Server"
                             PlaceholderText="firebox.example.com"
                             TextChanged="OnFieldChanged" />
                    <TextBox x:Name="WatchguardPortBox"
                             Header="Port"
                             Text="443"
                             TextChanged="OnFieldChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="Credentials" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBox x:Name="WatchguardUsernameBox"
                             Header="Username"
                             TextChanged="OnFieldChanged" />
                    <PasswordBox x:Name="WatchguardPasswordBox"
                                 Header="Password"
                                 PlaceholderText="not required for SAML"
                                 PasswordChanged="OnPasswordFieldChanged" />
                </StackPanel>
            </Grid>

            <Expander x:Name="WatchguardCertsExpander"
                      Header="Manual profile fallback &amp; advanced"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <TextBox x:Name="WatchguardDomainBox"
                             Header="Authentication domain override"
                             PlaceholderText="auto-detect" />
                    <TextBox x:Name="WatchguardCaPemBox"
                             Header="CA certificate (PEM)"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             MinHeight="80"
                             MaxHeight="140"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             TextChanged="OnFieldChanged" />
                    <TextBox x:Name="WatchguardClientCertPemBox"
                             Header="Client certificate (PEM)"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             MinHeight="80"
                             MaxHeight="140"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             TextChanged="OnFieldChanged" />
                    <TextBox x:Name="WatchguardClientKeyPemBox"
                             Header="Client private key (PEM)"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             MinHeight="80"
                             MaxHeight="140"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             TextChanged="OnFieldChanged" />
                    <TextBox x:Name="WatchguardVerifyX509NameBox"
                             Header="verify-x509-name subject (advanced)"
                             FontFamily="Consolas"
                             PlaceholderText="leave default unless the Firebox uses a custom server cert" />
                    <CheckBox x:Name="WatchguardTrustCertCheck"
                              Content="Trust the server certificate on the pre-auth login (skips its HTTPS check and the cert-subject pin)"
                              ToolTipService.ToolTip="Relaxes only the pre-authentication HTTPS exchange (where your credentials and OTP travel) and the verify-x509-name subject pin. The CA certificate you provide above is still required and still validates the VPN tunnel itself — enabling this does not allow a CA-less connection." />
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- Fortinet fields: Gateway and Credentials sit side-by-side; the Advanced
             expander spans the full width below so the TOTP/cert-pin block has room. -->
        <StackPanel x:Name="FortinetPanel" Spacing="10" Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="10">
                    <TextBlock Text="Gateway" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBox x:Name="FortinetHostBox"
                             Header="Host"
                             PlaceholderText="vpn.example.com"
                             TextChanged="OnFieldChanged" />
                    <TextBox x:Name="FortinetPortBox"
                             Header="Port"
                             Text="443"
                             TextChanged="OnFieldChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="Credentials" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBox x:Name="FortinetUsernameBox"
                             Header="Username"
                             TextChanged="OnFieldChanged" />
                    <PasswordBox x:Name="FortinetPasswordBox"
                                 Header="Password"
                                 PasswordChanged="OnPasswordFieldChanged" />
                    <TextBox x:Name="FortinetRealmBox"
                             Header="Realm (optional)" />
                </StackPanel>
            </Grid>

            <Expander Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <!-- A TOTP shared secret is a long-lived bearer credential equivalent to a
                         password: anyone who reads it can generate valid 2FA codes and bypass
                         MFA. Mask it with PasswordBox just like the password field above so it
                         doesn't appear in screen-shares, screenshots, or UI Automation readers. -->
                    <PasswordBox x:Name="FortinetTotpSecretBox"
                                 Header="TOTP shared secret (Base32, optional)"
                                 FontFamily="Consolas"
                                 PlaceholderText="leave blank if the gateway prompts interactively (unsupported in v1)"
                                 PasswordChanged="OnPasswordFieldChanged" />
                    <CheckBox x:Name="FortinetTrustCertCheck"
                              Content="Trust server certificate (skip verification)" />
                    <TextBox x:Name="FortinetCertPinBox"
                             Header="Server certificate SHA-256 pin (hex, optional)"
                             FontFamily="Consolas" />
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- Stormshield (SN SSL VPN) fields: OpenVPN over TLS with a Stormshield-native HTTPS
             handshake. Automatic mode authenticates to the firewall captive portal and fetches the
             per-user .ovpn; Import mode uses a static .ovpn downloaded from /auth "Personal data". -->
        <StackPanel x:Name="StormshieldPanel" Spacing="10" Visibility="Collapsed">
            <ComboBox x:Name="StormshieldModeBox"
                      Header="Connection mode"
                      HorizontalAlignment="Stretch"
                      SelectedIndex="0"
                      SelectionChanged="OnStormshieldModeChanged">
                <ComboBoxItem Content="Automatic — authenticate &amp; fetch config (Stormshield mode)" />
                <ComboBoxItem Content="Import — paste a downloaded .ovpn (OpenVPN mode)" />
            </ComboBox>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="10">
                    <TextBlock Text="Gateway" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBox x:Name="StormshieldServerBox"
                             Header="Server"
                             PlaceholderText="rpv.example.com"
                             TextChanged="OnFieldChanged" />
                    <TextBox x:Name="StormshieldPortBox"
                             Header="Port"
                             Text="443"
                             TextChanged="OnFieldChanged" />
                    <TextBox x:Name="StormshieldDescriptionBox"
                             Header="Description (optional)" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="Authentication" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                    <CheckBox x:Name="StormshieldSsoCheck"
                              Content="Connect with single sign-on"
                              IsEnabled="False"
                              ToolTipService.ToolTip="Single sign-on (browser/OIDC) is not yet supported — use username/password or import a profile." />
                    <TextBox x:Name="StormshieldUsernameBox"
                             Header="Username"
                             TextChanged="OnFieldChanged" />
                    <PasswordBox x:Name="StormshieldPasswordBox"
                                 Header="Password"
                                 PasswordChanged="OnPasswordFieldChanged" />
                    <CheckBox x:Name="StormshieldUseOtpCheck"
                              Content="Use an OTP"
                              ToolTipService.ToolTip="Prompt for a one-time code at connect time (single-use)." />
                </StackPanel>
            </Grid>

            <!-- Import mode only: the static .ovpn (inline ca/cert/key). -->
            <StackPanel x:Name="StormshieldImportPanel" Spacing="10" Visibility="Collapsed">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Profile"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Import from file…"
                            ToolTipService.ToolTip="Load a .ovpn downloaded from the firewall's /auth Personal data page"
                            Click="OnStormshieldImportOvpnFile" />
                </Grid>
                <InfoBar x:Name="StormshieldImportErrorBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Error"
                         Title="Couldn't read file" />
                <TextBox x:Name="StormshieldProfileOvpnBox"
                         Header="OpenVPN profile (.ovpn contents)"
                         PlaceholderText="client&#x0a;dev tun&#x0a;remote rpv.example.com 443 tcp&#x0a;..."
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         MinHeight="160"
                         MaxHeight="280"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         TextChanged="OnFieldChanged" />
            </StackPanel>

            <Expander Header="Certificates &amp; advanced"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <TextBox x:Name="StormshieldCaPemBox"
                             Header="Firewall CA certificate (PEM, for automatic mode)"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             MinHeight="80"
                             MaxHeight="140"
                             PlaceholderText="paste the SNS portal CA so its TLS cert validates (CN = appliance serial)"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    <CheckBox x:Name="StormshieldTrustCertCheck"
                              Content="Trust server certificate (skip ALL TLS checks — pre-auth credentials and OTP travel unverified)" />
                    <TextBox x:Name="StormshieldAppTokenBox"
                             Header="Portal app token (advanced)"
                             FontFamily="Consolas"
                             PlaceholderText="sslclient" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
