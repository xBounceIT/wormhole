<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Dialogs.FolderEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Wormhole.Models">

    <UserControl.Resources>
        <DataTemplate x:Key="CredentialItemTemplate" x:DataType="models:CredentialProfile">
            <TextBlock Text="{Binding Converter={StaticResource CredentialProfileDisplayConverter}}" />
        </DataTemplate>
        <DataTemplate x:Key="TunnelItemTemplate" x:DataType="models:TunnelConfig">
            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Padding="16" MinWidth="420">
        <StackPanel Spacing="12">
            <TextBox x:Name="NameBox"
                     Header="Name"
                     PlaceholderText="Production"
                     Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Spacing="4">
                <TextBlock Text="Credentials"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AvailableCredentials}"
                          ItemTemplate="{StaticResource CredentialItemTemplate}"
                          SelectedItem="{x:Bind ViewModel.SelectedCredential, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="Descendants that choose &quot;Inherit from folder&quot; use this saved credential. &quot;No credential&quot; overrides any inherited saved credential for the subtree." />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="VPN tunnel"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.TunnelPicker.AvailableTunnelConfigs}"
                          ItemTemplate="{StaticResource TunnelItemTemplate}"
                          SelectedItem="{x:Bind ViewModel.TunnelPicker.SelectedTunnel, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="Descendants that choose &quot;Inherit from folder&quot; pick up this tunnel. &quot;Inherit from parent&quot; defers to this folder's own parent; &quot;No tunnel&quot; overrides any inherited tunnel for the whole subtree." />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Auto sudo (SSH)"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.SshAutoSudoChoices}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Value"
                          SelectedValue="{x:Bind ViewModel.SshAutoSudoMode, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="Default for SSH descendants that choose &quot;Inherit from folder&quot;: when on, they run &quot;sudo su&quot; on connect and send the saved password. &quot;Inherit from parent&quot; defers to this folder's own parent." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
