<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Dialogs.FileTransferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wormhole.Views.Controls">

    <Grid RowSpacing="10"
          MinWidth="900"
          MinHeight="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE968;" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.ConnectionTitle, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.RemoteHost, Mode=OneWay}"
                       Opacity="0.7"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:FilePaneControl x:Name="LocalPaneControl" Grid.Column="0" />
            <controls:FilePaneControl x:Name="RemotePaneControl" Grid.Column="1" />
        </Grid>

        <controls:TransferQueueStrip Grid.Row="2"
                                     Transfers="{x:Bind ViewModel.Transfers, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.Transfers.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

        <!-- Close button row: built-in ContentDialog buttons stretch to fill their grid
             column (template local-value), so a single Close button becomes a full-width
             slab that can't be compacted via Style setters. Putting the button in the
             dialog Content avoids that and lets us style it directly. -->
        <Button Grid.Row="3"
                Content="Close"
                MinWidth="100"
                HorizontalAlignment="Right"
                Click="OnCloseClick"
                Style="{StaticResource AccentButtonStyle}" />

        <!-- Inline conflict overlay. WinUI 3 only permits one ContentDialog open at a
             time, and this UserControl is itself hosted inside a ContentDialog (see
             FileTransferDialogService.ShowAsync). A nested ContentDialog.ShowAsync
             throws COMException "Only a single ContentDialog can be open at any time."
             So overwrite prompts are surfaced as an in-content modal instead. -->
        <Grid x:Name="ConflictOverlay"
              Grid.RowSpan="4"
              Visibility="Collapsed"
              Background="#80000000"
              IsTabStop="True"
              KeyDown="OnConflictKeyDown">
            <Border MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="12" MinWidth="380">
                    <TextBlock Text="File exists" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ConflictMessage" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConflictSizes"
                               Opacity="0.7"
                               FontSize="12"
                               Visibility="Collapsed" />
                    <CheckBox x:Name="ConflictApplyAll" Content="Apply to remaining conflicts" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Overwrite" MinWidth="100" Click="OnConflictOverwrite" />
                        <Button x:Name="ConflictSkipButton"
                                Content="Skip"
                                MinWidth="100"
                                Click="OnConflictSkip"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Cancel" MinWidth="100" Click="OnConflictCancel" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
