<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Dialogs.FileTransferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wormhole.Views.Controls">

    <Grid RowSpacing="10"
          MinWidth="900"
          MinHeight="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE968;" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.ConnectionTitle, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.RemoteHost, Mode=OneWay}"
                       Opacity="0.7"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:FilePaneControl x:Name="LocalPaneControl" Grid.Column="0" />
            <controls:FilePaneControl x:Name="RemotePaneControl" Grid.Column="1" />
        </Grid>

        <controls:TransferQueueStrip Grid.Row="2"
                                     Transfers="{x:Bind ViewModel.Transfers, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.Transfers.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}" />

        <!-- Close button row: built-in ContentDialog buttons stretch to fill their grid
             column (template local-value), so a single Close button becomes a full-width
             slab that can't be compacted via Style setters. Putting the button in the
             dialog Content avoids that and lets us style it directly. -->
        <Button Grid.Row="3"
                Content="Close"
                MinWidth="100"
                HorizontalAlignment="Right"
                Click="OnCloseClick"
                Style="{StaticResource AccentButtonStyle}" />
    </Grid>
</UserControl>
