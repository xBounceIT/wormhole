<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Dialogs.CredentialDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBox x:Name="NameBox"
                 Header="Name"
                 PlaceholderText="prod-ssh"
                 TextChanged="OnFieldChanged" />

        <ComboBox x:Name="TypeBox"
                  Header="Type"
                  ItemsSource="{x:Bind Protocols}"
                  SelectedIndex="0"
                  SelectionChanged="OnTypeChanged"
                  HorizontalAlignment="Stretch" />

        <TextBox x:Name="UsernameBox"
                 Header="Username"
                 PlaceholderText="user"
                 TextChanged="OnFieldChanged" />

        <TextBox x:Name="DomainBox"
                 Header="Domain"
                 PlaceholderText="WORKGROUP"
                 Visibility="Collapsed"
                 TextChanged="OnFieldChanged" />

        <PasswordBox x:Name="PasswordField"
                     Header="Password"
                     PasswordChanged="OnPasswordChanged" />
    </StackPanel>
</UserControl>
