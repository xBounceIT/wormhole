<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wormhole.Views.Dialogs.BackupImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wormhole.Views.Dialogs">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  MaxHeight="560"
                  MinWidth="480">
        <StackPanel Spacing="12" Padding="0,0,12,0">

            <TextBlock TextWrapping="Wrap">
                Restore a backup exported from another Wormhole installation. Items already
                present in this database (matched by ID) are kept as-is and the imported copy
                is skipped — no overwrites.
            </TextBlock>

            <TextBlock Text="Backup file"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="0,8,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         IsReadOnly="True"
                         PlaceholderText="No file selected"
                         Header="Backup file (.json)"
                         Text="{x:Bind ViewModel.SelectedPath, Mode=OneWay}" />
                <Button Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Content="Choose file..."
                        IsEnabled="{x:Bind ViewModel.CanPickFile, Mode=OneWay}"
                        Click="OnPickFile" />
                <Button Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Content="Import"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.StartImportCommand}" />
            </Grid>

            <!-- Password panel (only when the file is encrypted). -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEncrypted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{x:Bind ViewModel.FileIsEncryptedMessage, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <PasswordBox x:Name="PasswordInput"
                             Header="Password"
                             PasswordChanged="OnPasswordChanged"
                             KeyDown="OnPasswordKeyDown"
                             PlaceholderText="Enter the backup password" />
                <TextBlock Text="{x:Bind ViewModel.PasswordError, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.PasswordError, Mode=OneWay, Converter={StaticResource StringPresentVisibilityConverter}}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Progress -->
            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar Value="{x:Bind ViewModel.Percent, Mode=OneWay}" Minimum="0" Maximum="100" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="Cancel"
                            Command="{x:Bind ViewModel.CancelCommand}" />
                </Grid>
            </StackPanel>

            <!-- Result -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Success"
                     Title="Import complete"
                     Message="{x:Bind ViewModel.Status, Mode=OneWay}" />

            <!-- Out-of-band status for cancel/error states. -->
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind local:BackupImportDialog.OutOfBandStatusVisibility(ViewModel.Status, ViewModel.IsBusy, ViewModel.HasResult, ViewModel.IsEncrypted), Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
