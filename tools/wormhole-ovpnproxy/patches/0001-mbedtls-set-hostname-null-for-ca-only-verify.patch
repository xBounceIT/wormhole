@@ -942,11 +942,22 @@ class MbedTLSContext : public SSLFactoryAPI
                 // In pre-mbedtls-2.x the hostname for the CA chain was set in ssl_set_ca_chain().
                 // From mbedtls-2.x, the hostname must be set via mbedtls_ssl_set_hostname()
                 // https://tls.mbed.org/kb/how-to/upgrade-2.0
-                if (hostname && ((c.flags & SSLConst::ENABLE_CLIENT_SNI) || c.ca_chain))
-                {
-                    if (mbedtls_ssl_set_hostname(ssl, hostname))
-                        throw MbedTLSException("mbedtls_ssl_set_hostname failed");
-                }
+                // Wormhole patch (aligned with openvpn3 master): mbedTLS 3.6+ refuses to verify
+                // a server certificate unless mbedtls_ssl_set_hostname() has been called at least
+                // once — even with NULL — otherwise the handshake fails with "Attempt to verify a
+                // certificate without an expected hostname". OpenVPN authenticates the server by CA
+                // chain (plus the optional verify-x509-name check in verify_callback_client), NOT by
+                // TLS hostname/SNI, and frequently connects to a bare IP whose server cert CN never
+                // matches (e.g. Stormshield appliances put the appliance serial in the CN). So call
+                // set_hostname UNCONDITIONALLY, passing the real name only when we actually have a
+                // non-empty one and either SNI or a CA chain wants it; otherwise pass NULL to opt out
+                // of the hostname/CN check while keeping CA verification REQUIRED — matching the
+                // OpenSSL backend's default behavior. (Previously this was only called when `hostname`
+                // was non-null, and the client passes an empty string here, so it was never set.)
+                const bool use_hostname = hostname && hostname[0]
+                    && ((c.flags & SSLConst::ENABLE_CLIENT_SNI) || c.ca_chain);
+                if (mbedtls_ssl_set_hostname(ssl, use_hostname ? hostname : nullptr))
+                    throw MbedTLSException("mbedtls_ssl_set_hostname failed");
 
