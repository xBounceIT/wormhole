<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Wormhole.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wormhole"
    xmlns:conv="using:Wormhole.Helpers.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:StringPresentVisibilityConverter x:Key="StringPresentVisibilityConverter" />
            <conv:ToUpperConverter x:Key="ToUpperConverter" />

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="6" />
            </Style>

            <!-- Same look as IconButtonStyle but for DropDownButton — Style.TargetType is
                 type-checked at parse time, so the two cannot share an instance. -->
            <Style x:Key="IconDropDownButtonStyle" TargetType="DropDownButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
