<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Wormhole.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wormhole"
    xmlns:conv="using:Wormhole.Helpers.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LockOverlayBackgroundBrush" Color="#FF0F0F0F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LockOverlayBackgroundBrush" Color="#FFF7F7F7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LockOverlayBackgroundBrush" Color="#FF0F0F0F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
            <conv:StringPresentVisibilityConverter x:Key="StringPresentVisibilityConverter" />
            <conv:ToUpperConverter x:Key="ToUpperConverter" />
            <conv:DirectoryGlyphConverter x:Key="DirectoryGlyphConverter" />
            <conv:ByteSizeConverter x:Key="ByteSizeConverter" />
            <conv:UtcDateConverter x:Key="UtcDateConverter" />
            <conv:ProgressFractionConverter x:Key="ProgressFractionConverter" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <conv:TransferStateGlyphConverter x:Key="TransferStateGlyphConverter" />
            <conv:TransferStateTerminalVisibilityConverter x:Key="TransferStateTerminalVisibilityConverter" />
            <conv:TransferStateBrushConverter x:Key="TransferStateBrushConverter" />
            <conv:ConnectionStepStateToBrushConverter x:Key="ConnectionStepStateToBrushConverter" />

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="6" />
            </Style>

            <!-- Same look as IconButtonStyle but for DropDownButton — Style.TargetType is
                 type-checked at parse time, so the two cannot share an instance. -->
            <Style x:Key="IconDropDownButtonStyle" TargetType="DropDownButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
