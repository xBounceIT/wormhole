# Build outputs
bin/
obj/
artifacts/
node_modules/
dist/
dist-electron/
*.binlog

# Visual Studio
.vs/
*.user
*.suo

# Rider / VS Code
.idea/
.vscode/
*.swp

# Generated WinUI files
*.g.cs
*.g.i.cs
*.xbf
*.pri

# Logs
logs/
*.log

# Local database files (developer scratch only; runtime DB lives in %LOCALAPPDATA%)
*.db
*.db-shm
*.db-wal

# Installer outputs
installer/output/


# Fetched web assets (xterm.js etc.) -- populated by scripts/Fetch-WebAssets.ps1
Assets/web/vendor/

# C++ shim build outputs from CMake + vcpkg manifest mode.
tools/wormhole-ovpnproxy/ovpn_shim/build/

# Generated by Fetch-OvpnProxy.ps1 to bust go build's cgo link cache when libovpn_shim.a
# changes (the archive's content isn't part of go build's cache key). Regenerated each build.
tools/wormhole-ovpnproxy/shim_buildinfo.go

# Sidecar binaries left behind by `go build` invoked from inside a sidecar dir.
# The canonical build path (MSBuild Fetch-*.ps1 targets) writes to obj/, which is
# already covered above; this catches the stray copies for developers iterating
# on the Go code directly.
tools/wormhole-*/wormhole-*proxy
tools/wormhole-*/wormhole-*proxy.exe

# OS noise
Thumbs.db
desktop.ini
.DS_Store
.claude/
