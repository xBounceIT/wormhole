<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 (no -windows) so this project builds and runs on the Linux CI
         runner. The cross-platform tunneling code path is the surface under test;
         WinUI / WebView2 / WindowsAppSDK are deliberately not referenced here. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Shared <Compile Include> source links mirror the main test project's pattern.
         dotnet format would otherwise propose conflicting using-removals between the
         two compilation contexts (main project + this project), so suppress IDE0005
         here as well. -->
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- SkippableFact gives us conditional skip-with-reason on xUnit 2.x; without it
         a missing env var either fails noisily or silently passes. Lets developers
         run `dotnet test Wormhole.Tests.Integration` locally and see "Skipped: not
         configured" instead of false-green. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Link the cross-platform tunneling source from the main project. Every file
       below is pure System.* + Microsoft.Extensions.Logging — no WinUI, no
       WindowsAppSDK, no platform-specific P/Invoke. Verified portable for the
       Linux runner. -->
  <ItemGroup>
    <Compile Include="..\Services\Tunneling\Socks5Client.cs" Link="Services\Tunneling\Socks5Client.cs" />
    <Compile Include="..\Services\Tunneling\WireGuard\WireGuardProcessHost.cs" Link="Services\Tunneling\WireGuard\WireGuardProcessHost.cs" />
    <Compile Include="..\Services\Tunneling\WireGuard\WireGuardSidecarConfig.cs" Link="Services\Tunneling\WireGuard\WireGuardSidecarConfig.cs" />
    <Compile Include="..\Services\Tunneling\OpenVpn\OpenVpnProcessHost.cs" Link="Services\Tunneling\OpenVpn\OpenVpnProcessHost.cs" />
    <Compile Include="..\Services\Tunneling\OpenVpn\OpenVpnSidecarConfig.cs" Link="Services\Tunneling\OpenVpn\OpenVpnSidecarConfig.cs" />
  </ItemGroup>

</Project>
